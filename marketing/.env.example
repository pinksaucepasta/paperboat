# The control plane the site reads its addresses from (GET /v1/client-configuration).
PAPERBOAT_API_URL=https://api.example.test
# Where this site is served: canonical links, the sitemap and share images use it.
PAPERBOAT_SITE_URL=https://www.example.test
# Product analytics (PostHog), optional: without them the site sends nothing. A public browser key and the EU host.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=
# The status page (its own Cloudflare Pages project), optional: /status/ redirects there and the footer links to it. Default for an https
# site: status.<the site's domain>. Set it only to point somewhere else.
PAPERBOAT_STATUS_URL=
