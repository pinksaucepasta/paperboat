---
/** Every page: the header, the page, the footer. */
import Base from "./Base.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
interface Props {
  title: string
  description: string
  schema?: Record<string, unknown>[]
  noindex?: boolean
}
---

<Base {...Astro.props}>
  <Nav />
  <main id="main">
    <slot />
  </main>
  <Footer />
</Base>
