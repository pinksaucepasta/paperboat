---
/**
 * A legal page: title, last-updated date, a table of contents beside the text, and the text in sections
 * (`<section id>` with an `h2`, written by the page). Pages stay out of search while a company fact is missing.
 */
import Page from "./Page.astro"
import Head from "../components/Head.astro"
import { legalDraft, legalPage, legalPages } from "../legal-data"
import { breadcrumbSchema } from "../schema"

interface Props {
  slug: string
  description: string
  /** [id, label] of each section, in order. */
  sections: [string, string][]
}
const { slug, description, sections } = Astro.props
const page = legalPage(slug)
const date = new Date(`${page.updated}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
---

<Page
  title={`${page.title} | Paperboat`}
  description={description}
  noindex={legalDraft}
  schema={[breadcrumbSchema(Astro.site, [[page.title, `/legal/${slug}/`]])]}
>
  <Head title={page.title}>
    <slot name="intro" />
    <p class="small updated">Last updated <time datetime={page.updated}>{date}</time></p>
  </Head>

  <div class="wrap layout">
    <nav class="toc" aria-label="On this page">
      <ol>
        {sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
      </ol>
      <p class="others">
        Other policies:
        {legalPages.filter((other) => other.slug !== slug).map((other, i) => <>{i > 0 && ", "}<a href={`/legal/${other.slug}/`}>{other.short}</a></>)}
      </p>
    </nav>
    <div class="body legal">
      <slot />
    </div>
  </div>
</Page>

<style>
  .updated {
    color: var(--fog);
  }

  .layout {
    display: grid;
    gap: var(--s7);
    padding-bottom: var(--section);
  }

  .toc ol {
    display: grid;
    padding-block: var(--s3);
    border-block: 1px solid var(--rule);
    font-size: var(--text-ui);
  }

  .toc a {
    color: var(--fog);
  }

  .toc li a {
    display: flex;
    align-items: center;
    min-height: 36px;
  }

  .toc a:hover {
    color: var(--ink);
  }

  .others {
    margin-top: var(--s4);
    font-size: var(--text-small);
    color: var(--fog);
  }

  .others a {
    text-decoration: underline;
    text-decoration-color: var(--rule);
  }

  .body {
    display: grid;
    gap: var(--s7);
    min-width: 0;
    max-width: 46rem;
  }

  .legal :global(section) {
    display: grid;
    gap: var(--s4);
    scroll-margin-top: calc(var(--header) + var(--s5));
  }

  .legal :global(h2) {
    font-size: var(--text-h3);
    font-weight: 500;
    color: var(--ink);
  }

  .legal :global(h3) {
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--ink);
  }

  .legal :global(.prose) {
    max-width: none;
  }

  .legal :global(ol) {
    display: grid;
    gap: var(--s2);
    padding-left: 1.4em;
    list-style: decimal;
  }

  .legal :global(table) {
    min-width: 560px;
  }

  .legal :global(mark.todo) {
    padding: 0 0.25em;
    border-radius: 3px;
    background: #fff3b0;
    color: var(--ink);
  }

  @media (min-width: 1000px) {
    .layout {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: var(--s8);
      align-items: start;
    }

    .toc {
      position: sticky;
      top: calc(var(--header) + var(--s5));
    }

    .toc ol {
      border: 0;
      padding: 0;
    }
  }
</style>
