---
import Section from "./Section.astro"
import TerminalRoom from "./TerminalRoom.astro"
---

<Section id="terminals" title="Terminals that don’t die.">
  <Fragment slot="text">
    <p>
      Your shell runs on the machine, not on your laptop. Close the lid or lose Wi-Fi and it keeps going. Open it from
      a terminal, a browser or your phone. Share it when you want help.
    </p>
  </Fragment>
  <div>
    <TerminalRoom />
  </div>

  <div class="ssh">
    <div>
      <h3 class="subtitle">Plain SSH works too.</h3>
      <p class="body">
        Use <code>pb ssh</code>, or plain <code>ssh</code> from VS Code, Cursor, Zed or any other tool.
        Paperboat handles the keys.
      </p>
    </div>
    <div class="ssh-lines">
      <code><span class="dollar">$</span> pb ssh homelab</code>
      <code><span class="dollar">$</span> ssh homelab.pprbt</code>
      <code><span class="dollar">$</span> rsync -a ./site homelab.pprbt:/srv</code>
    </div>
  </div>
</Section>

<style>
  .ssh {
    display: grid;
    gap: 24px 64px;
    margin-top: clamp(40px, 5vw, 56px);
    padding-top: 32px;
    border-top: 1px solid var(--rule);
  }

  .ssh .body {
    margin-top: 10px;
    max-width: 46ch;
  }

  .ssh-lines {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 18px 20px;
    border-radius: 10px;
    background: var(--surface);
    overflow-x: auto;
  }

  code {
    font-size: 0.875rem;
    color: var(--ink);
    white-space: nowrap;
  }

  .dollar {
    color: var(--faint);
  }

  @media (min-width: 900px) {
    .ssh {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
