---
/**
 * The home hero's use cases: three cards, each a link to its page with one small picture of the
 * product. One border and one radius per card; the picture is a full-width band the card clips.
 */
import Icon from "./Icon.astro"
import { installerBase, localDomain } from "../site"

const installHost = new URL(installerBase).host
const members = ["A", "M", "J"]
---

<div class="uses">
  <a class="use" href="/use-cases/ai-agents/">
    <span class="head"><Icon name="robot" size={18} class="icon" /><span class="name">AI agents</span><Icon name="arrow-right" size={16} class="arrow" /></span>
    <span class="band band-term">
      <span class="line"><span class="prompt">$</span> curl -fsSL {installHost} | PB_RECIPE=… sh</span>
      <span class="line ok"><span>✓ Paired</span><span>✓ Secrets</span><span>✓ Preview</span></span>
    </span>
  </a>

  <a class="use" href="/use-cases/teams/">
    <span class="head"><Icon name="users-three" size={18} class="icon" /><span class="name">Teams</span><Icon name="arrow-right" size={16} class="arrow" /></span>
    <span class="band">
      <span class="line">
        <span class="avatars">{members.map((m) => <span class="avatar">{m}</span>)}</span>
        <span class="mono">oncall → tag:prod</span>
        <span class="actions-list"><span>terminal</span><span>exec</span></span>
      </span>
    </span>
  </a>

  <a class="use" href="/use-cases/homelab/">
    <span class="head"><Icon name="house-line" size={18} class="icon" /><span class="name">Home lab</span><Icon name="arrow-right" size={16} class="arrow" /></span>
    <span class="band">
      <span class="line"><span class="dot"></span><span class="mono">jellyfin.{localDomain}</span></span>
      <span class="line"><span class="dot"></span><span class="mono">photos.{localDomain}</span><span class="public">· public</span></span>
    </span>
  </a>
</div>

<style>
  .uses {
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: var(--s3);
    min-width: 0;
  }

  .use {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-radius: 12px;
    background: var(--paper);
    box-shadow:
      0 0 0 1px var(--rule),
      0 16px 32px -24px rgb(20 20 20 / 0.18);
    overflow: hidden;
    color: var(--ink);
    transition: box-shadow 0.15s ease;
  }

  .use:hover {
    box-shadow:
      0 0 0 1px rgb(20 20 20 / 0.28),
      0 16px 32px -24px rgb(20 20 20 / 0.18);
  }

  .use:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 3px;
  }

  .head {
    display: flex;
    align-items: center;
    gap: var(--s2);
    padding: 10px var(--s4);
  }

  .head :global(.icon) {
    color: var(--cobalt);
  }

  .name {
    flex: 1;
    font-weight: 500;
  }

  .head :global(.arrow) {
    color: var(--fog);
    transition: transform 0.15s ease;
  }

  .use:hover .head :global(.arrow) {
    color: var(--ink);
    transform: translateX(3px);
  }

  /* The picture: a full-width band; the card's own radius clips its bottom corners. */
  .band {
    flex: 1;
    display: grid;
    align-content: center;
    gap: 4px;
    padding: var(--s2) var(--s4);
    background: var(--surface);
    font-size: var(--text-small);
    min-width: 0;
  }

  .band-term {
    background: #16171a;
    color: #e8e8e6;
  }

  .line {
    display: flex;
    align-items: center;
    gap: var(--s2);
    min-width: 0;
    white-space: nowrap;
  }

  .band-term .line {
    display: block;
    font-family: var(--font-mono);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .prompt {
    color: var(--sky);
  }

  .ok {
    color: #5fd3a5;
  }

  .ok span + span {
    margin-left: 1.5ch;
  }

  .mono {
    font-family: var(--font-mono);
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .avatars {
    display: flex;
    flex-shrink: 0;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-left: -4px;
    border-radius: 50%;
    background: var(--hull);
    box-shadow: 0 0 0 2px var(--surface);
    font-size: var(--text-tiny);
    font-weight: 600;
    color: var(--cobalt);
  }

  .avatar:first-child {
    margin-left: 0;
  }

  .actions-list {
    display: flex;
    gap: 1ch;
    margin-left: auto;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    color: var(--cobalt);
  }

  .dot {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--good);
  }

  .public {
    flex-shrink: 0;
    color: var(--cobalt);
  }

  @media (prefers-reduced-motion: reduce) {
    .use,
    .head :global(.arrow) {
      transition: none;
    }
  }
</style>
