---
/** The home hero's use cases: a plain list, each row a link to its page. */
import Icon from "./Icon.astro"
import { useCases } from "../features"
---

<ul class="uses" aria-label="Use cases">
  {
    useCases.map((item) => (
      <li>
        <a href={`/use-cases/${item.slug}/`}>
          <span class="name">{item.name}</span>
          <span class="line">{item.line}</span>
          <Icon name="arrow-right" size={16} class="arrow" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .uses {
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--rule);
  }

  li {
    display: grid;
    border-top: 1px solid var(--rule);
  }

  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-content: center;
    column-gap: var(--s4);
    row-gap: 2px;
    padding-block: var(--s4);
  }

  a:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .name {
    font-size: var(--text-card);
    font-weight: 500;
    color: var(--ink);
  }

  .line {
    grid-column: 1;
    font-size: var(--text-ui);
    color: var(--fog);
    text-wrap: pretty;
  }

  a :global(.arrow) {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--fog);
    transition: transform 0.15s ease;
  }

  a:hover .name {
    color: var(--cobalt);
  }

  a:hover :global(.arrow) {
    color: var(--cobalt);
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    a :global(.arrow) {
      transition: none;
    }
  }
</style>
