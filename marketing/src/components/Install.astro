---
import Icon from "./Icon.astro"
import { installCommand } from "../site"
/** The install command, as the console's Add machine dialog shows it: the command, and clicking copies. */
interface Props {
  tone?: "light" | "sea"
}
const { tone = "light" } = Astro.props
---
<div class:list={["install", `install-${tone}`]}>
  <p class="install-platform">macOS and Linux</p>
  <button class="install-command" aria-label="Copy install command" data-copy={installCommand}>
    <code>{installCommand}</code>
    <span class="install-icon">
      <Icon name="copy" size={16} class="when-idle" />
      <Icon name="check" size={16} class="when-copied" />
    </span>
  </button>
</div>
<style>
  .install {
    width: 100%;
    max-width: 560px;
  }

  .install-platform {
    margin-bottom: 8px;
    font-size: 0.8125rem;
    color: var(--fog);
  }

  .install-command {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 12px 14px 12px 16px;
    border-radius: 10px;
    background: var(--surface);
    text-align: left;
    transition: background-color 0.15s ease;
  }

  .install-command:hover {
    background: var(--surface-strong);
  }

  .install-command code {
    flex: 1;
    min-width: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink);
    word-break: break-all;
  }

  .install-command code::before {
    content: "$ ";
    color: var(--faint);
  }

  .install-icon {
    color: var(--fog);
    flex-shrink: 0;
  }

  .install-command:hover .install-icon {
    color: var(--ink);
  }

  .install-icon :global(.when-copied),
  [data-copied] .install-icon :global(.when-idle) {
    display: none;
  }

  [data-copied] .install-icon :global(.when-copied) {
    display: block;
    color: var(--success);
  }

  /* On the brand gradient: white on blue, no tints of the blue (brand guidelines 05). */
  .install-sea .install-platform {
    color: rgb(255 255 255 / 0.72);
  }

  .install-sea .install-command {
    background: rgb(11 11 12 / 0.28);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }

  .install-sea .install-command:hover {
    background: rgb(11 11 12 / 0.36);
  }

  .install-sea .install-command code {
    color: #fff;
  }

  .install-sea .install-command code::before,
  .install-sea .install-icon {
    color: rgb(255 255 255 / 0.6);
  }

  .install-sea [data-copied] .install-icon :global(.when-copied),
  .install-sea .install-command:hover .install-icon {
    color: #fff;
  }
</style>
