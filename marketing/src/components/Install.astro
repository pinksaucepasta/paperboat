---
import Icon from "./Icon.astro"
import { installCommand, platforms } from "../site"
/** The install command; pressing it copies. */
interface Props {
  tone?: "light" | "sea"
}
const { tone = "light" } = Astro.props
---

<div class:list={["install", `install-${tone}`]}>
  <button class="install-command" type="button" data-copy={installCommand}>
    <span class="visually-hidden">Copy the install command: </span>
    <code><span class="prompt">$ </span>{installCommand}</code>
    <span class="install-icon">
      <Icon name="copy" size={18} class="when-idle" />
      <Icon name="check" size={18} class="when-copied" />
    </span>
    <span class="visually-hidden" role="status" data-copy-status></span>
  </button>
  <p class="install-note">{platforms}. No account needed first: your browser opens to sign in when it finishes.</p>
</div>

<style>
  .install {
    display: grid;
    gap: var(--s3);
    width: 100%;
    max-width: 540px;
  }

  .install-command {
    position: relative;
    display: flex;
    width: 100%;
    align-items: center;
    gap: var(--s3);
    min-height: 56px;
    padding: var(--s3) var(--s4);
    border-radius: var(--radius);
    background: var(--ink);
    text-align: left;
  }

  .install-command code {
    flex: 1;
    min-width: 0;
    line-height: 1.5;
    color: #fff;
    overflow-wrap: anywhere;
  }

  .prompt {
    color: rgb(255 255 255 / 0.55);
    user-select: none;
  }

  .install-icon {
    flex-shrink: 0;
    color: rgb(255 255 255 / 0.7);
  }

  .install-command:hover .install-icon {
    color: #fff;
  }

  .install-icon :global(.when-copied),
  [data-copied] .install-icon :global(.when-idle) {
    display: none;
  }

  [data-copied] .install-icon :global(.when-copied) {
    display: block;
    color: #fff;
  }

  .install-note {
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--fog);
  }

  .install-sea .install-command {
    background: rgb(11 11 12 / 0.32);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
  }

  .install-sea .install-note {
    color: rgb(255 255 255 / 0.85);
  }

  .install-sea :global(:focus-visible),
  .install-sea.install :focus-visible {
    outline-color: #fff;
  }
</style>
