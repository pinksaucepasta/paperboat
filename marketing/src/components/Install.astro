---
import Icon from "./Icon.astro"
import { installCommand, installUrl, windowsInstallCommand } from "../site"
/**
 * The install command, with its copy button inside the box; below it the platform switch and a link
 * to the script itself. No script: radio inputs pick the platform, so both commands share one box.
 */
const id = `os-${Math.random().toString(36).slice(2, 8)}`
const commands = [
  { key: "unix", label: "macOS & Linux", command: installCommand, prompt: "$", script: installUrl },
  { key: "windows", label: "Windows", command: windowsInstallCommand, prompt: ">", script: `${installUrl}.ps1` },
]
---

<div class="install">
  <input class="os-input" type="radio" name={id} id={`${id}-unix`} checked />
  <input class="os-input" type="radio" name={id} id={`${id}-windows`} data-windows-tab />
  <div class="boxes">
    {
      commands.map((item) => (
        <div class:list={["box", `os-${item.key}`]}>
          <code class="command">
            <span class="prompt">{item.prompt}</span> {item.command}
          </code>
          <button class="copy" type="button" data-copy={item.command} aria-label={`Copy the ${item.label} install command`}>
            <Icon name="copy" size={18} class="when-idle" />
            <Icon name="check" size={18} class="when-copied" />
            <span class="visually-hidden" role="status" data-copy-status />
          </button>
        </div>
      ))
    }
  </div>
  <div class="below">
    <div class="os" role="group" aria-label="Operating system">
      {commands.map((item) => <label for={`${id}-${item.key}`}>{item.label}</label>)}
    </div>
    {
      commands.map((item) => (
        <a class:list={["script", `os-${item.key}`]} href={item.script} rel="noopener">
          View install script <Icon name="arrow-up-right" size={14} />
        </a>
      ))
    }
  </div>
</div>

<style>
  .install {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s3);
    width: 100%;
    max-width: 560px;
  }

  .os-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  /* Both boxes share one cell, so switching platform never changes the width. */
  .boxes {
    display: grid;
  }

  .box {
    grid-area: 1 / 1;
    display: flex;
    align-items: stretch;
    min-height: 56px;
    border-radius: var(--radius);
    background: var(--ink);
    overflow: hidden;
  }

  .command {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.6em;
    min-width: 0;
    padding: 0 var(--s5);
    font-size: var(--text-ui);
    color: #fff;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .prompt {
    color: var(--sky);
    user-select: none;
  }

  .copy {
    display: grid;
    place-items: center;
    width: 56px;
    flex-shrink: 0;
    border-left: 1px solid rgb(255 255 255 / 0.12);
    color: rgb(255 255 255 / 0.7);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .copy:hover {
    background: rgb(255 255 255 / 0.06);
    color: #fff;
  }

  .copy :global(.when-copied),
  .copy[data-copied] :global(.when-idle) {
    display: none;
  }

  .copy[data-copied] :global(.when-copied) {
    display: block;
    color: #fff;
  }

  .below {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
  }

  .os {
    display: inline-flex;
    padding: 3px;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  .os label {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding-inline: var(--s3);
    border-radius: 6px;
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--fog);
    white-space: nowrap;
    cursor: pointer;
  }

  .os label:hover {
    color: var(--ink);
  }

  .os-input:nth-of-type(1):checked ~ .below .os label:nth-child(1),
  .os-input:nth-of-type(2):checked ~ .below .os label:nth-child(2) {
    background: var(--surface-strong);
    color: var(--ink);
  }

  .os-input:focus-visible ~ .below .os {
    outline: 2px solid var(--cobalt);
    outline-offset: 2px;
  }

  .script {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 32px;
    font-size: var(--text-small);
    color: var(--fog);
    white-space: nowrap;
  }

  .script:hover {
    color: var(--ink);
  }

  .os-input:nth-of-type(1):checked ~ .boxes .os-windows,
  .os-input:nth-of-type(2):checked ~ .boxes .os-unix {
    visibility: hidden;
  }

  .os-input:nth-of-type(1):checked ~ .below .os-windows,
  .os-input:nth-of-type(2):checked ~ .below .os-unix {
    display: none;
  }
</style>
