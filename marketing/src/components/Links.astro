---
import Section from "./Section.astro"
import Icon from "./Icon.astro"
import { previewDomain, tunnelDomain } from "../site"
---

<Section id="links" title="Share a port">
  <Fragment slot="text">
    <p>
      One command gives an app on your machine a public link. Nothing to deploy.
    </p>
  </Fragment>

  <div class="cards">
    <article class="card surface-pattern">
      <div class="card-head">
        <h3 class="subtitle">Previews</h3>
        <p class="body">A temporary link to a port. Open to anyone, only you, or your team.</p>
      </div>
      <pre class="out"><span class="dollar">$</span> pb preview 3000
Preview ready
<span class="url">https://quiet-river-lantern-4821.{previewDomain}</span> -&gt; http://127.0.0.1:3000

<span class="dim">Press Ctrl+C to stop</span></pre>
    </article>

    <article class="card surface-pattern">
      <div class="card-head">
        <h3 class="subtitle">Tunnels</h3>
        <p class="body">A permanent address for a service. Use your own domain. We handle the certificates.</p>
      </div>
      <pre class="out"><span class="dollar">$</span> pb tunnel create api --port 8080
Created tunnel api (tunnel_4kq81zc2)
Connector connector_9d2f7a is ready
<span class="url">https://calm-summer-beach-3476.{tunnelDomain}</span> -&gt; http://127.0.0.1:8080
Status: ready</pre>
    </article>
  </div>

  <div class="extras">
    <div class="extra">
      <Icon name="file-arrow-up" size={20} class="extra-icon" />
      <div>
        <h3 class="extra-title">Send files between machines.</h3>
        <p class="body">
          Run <code>pb send ./report.pdf --to homelab</code>, or drop a file into a machine’s Inbox in the console.
        </p>
      </div>
    </div>
    <div class="extra">
      <Icon name="hard-drives" size={20} class="extra-icon" />
      <div>
        <h3 class="extra-title">Run your own edge.</h3>
        <p class="body">
          Serve previews and tunnels from your own server and domain.
        </p>
        <a class="more" href="/#selfhost">Set one up <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</Section>

<style>
  .cards {
    display: grid;
    gap: 16px;
  }

  .card {
    display: grid;
    gap: 28px;
    align-content: space-between;
    padding: clamp(24px, 3.2vw, 36px);
  }

  .card-head {
    display: grid;
    gap: 8px;
  }

  .card .body {
    font-size: 1rem;
    max-width: 40ch;
  }

  .out {
    margin: 0;
    padding: 18px 20px;
    border-radius: 10px;
    background: var(--background);
    box-shadow: 0 0 0 1px var(--rule);
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--ink);
    overflow-x: auto;
  }

  .dollar,
  .dim {
    color: var(--faint);
  }

  .url {
    color: var(--cobalt);
  }

  .extras {
    display: grid;
    gap: 32px 48px;
    margin-top: clamp(40px, 5vw, 56px);
  }

  .extra {
    display: flex;
    gap: 16px;
  }

  .extra :global(.extra-icon) {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--cobalt);
  }

  .extra-title {
    font-family: var(--font-brand);
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .extra .body {
    margin-top: 6px;
    font-size: 1rem;
    max-width: 46ch;
  }

  .extra code {
    font-size: 0.875em;
    color: var(--ink);
  }

  .more {
    display: inline-block;
    margin-top: 10px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--cobalt);
  }

  .more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 900px) {
    .cards,
    .extras {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
