---
/** The top of an inner page: the page's one h1 and a line under it, in the same rhythm as a section. */
interface Props {
  title: string
  /** A small label above the title, such as the product's name. */
  eyebrow?: string
}
const { title, eyebrow } = Astro.props
// A short title ("Pricing") is set at the display size; a sentence is set one step smaller so it stays on two lines.
const size = title.length > 24 ? "title" : "display"
---

<section class="page-head">
  <div class="wrap">
    <header class="page-head-text">
      {eyebrow && <p class="chapter">{eyebrow}</p>}
      <h1 class={size}>{title}</h1>
      <div class="lede page-head-lede"><slot /></div>
    </header>
  </div>
</section>

<style>
  .page-head {
    padding-block: clamp(64px, 7vw, 96px) 0;
  }

  .page-head-text {
    display: grid;
    gap: 18px;
    max-width: 640px;
  }
</style>
