---
import Mark from "./Mark.astro"
import Icon from "./Icon.astro"
/**
 * The console's terminal page (paperboat-console/components/terminal/terminal-page.tsx): the top
 * bar with its breadcrumb, tools, people and Share; the terminal in the Paperboat Dark theme with
 * its status line; and the People panel. The script plays a dropped connection and the replay.
 */
const prompt = "mira@studio ~/src/api %"
const script = [
  { html: "go build -trimpath -o bin/api ./cmd/api", gap: 500 },
  { html: "go test ./...", gap: 700 },
  { html: '<span class="g">ok</span>   example.com/api/internal/auth       2.114s', gap: 900 },
  { html: '<span class="g">ok</span>   example.com/api/internal/billing    4.870s', gap: 700 },
  { html: '<span class="g">ok</span>   example.com/api/internal/store     11.302s', missed: true },
  { html: '<span class="g">ok</span>   example.com/api/internal/webhooks   3.551s', missed: true },
  { html: '<span class="g">ok</span>   example.com/api/cmd/api             0.912s', missed: true },
  { html: "docker build -t api:2026.10.13 .", missed: true },
  { html: '<span class="b">[+] Building 38.2s (14/14) FINISHED</span>', missed: true },
  { html: "docker push registry.internal/api:2026.10.13", gap: 900 },
  { html: '<span class="dim">2026.10.13: digest: sha256:9f2c41d7 size: 1786</span>', gap: 1100 },
]
const people = [
  { name: "You", letter: "Y", role: "Owner" },
  { name: "Elena", letter: "E", role: "Can type" },
  { name: "Ben", letter: "B", role: "Watching" },
]
---

<figure class="room-figure">
  <div class="room" data-room data-prompt={prompt} data-script={JSON.stringify(script)} aria-hidden="true">
    <div class="bar">
      <span class="crumbs">
        <Mark height={18} class="crumb-mark" />
        <Icon name="caret-right" size={12} class="crumb-sep" />
        <span class="crumb hide-sm">Terminals</span>
        <Icon name="caret-right" size={12} class="crumb-sep hide-sm" />
        <span class="crumb">studio</span>
        <Icon name="caret-right" size={12} class="crumb-sep" />
        <span class="crumb current">api-build</span>
      </span>
      <span class="actions">
        <span class="tool hide-md"><Icon name="upload-simple" size={16} /></span>
        <span class="tool hide-md"><Icon name="arrows-out" size={16} /></span>
        <span class="tool hide-md"><Icon name="palette" size={16} /></span>
        <span class="tool hide-md"><Icon name="power" size={16} /></span>
        <span class="divider hide-md"></span>
        <span class="people-toggle">
          <span class="stack">{people.map((p) => <span class="tile">{p.letter}</span>)}</span>
          <span class="count">{people.length}</span>
        </span>
        <span class="share">Share</span>
      </span>
    </div>
    <div class="body">
      <div class="term">
        <div class="screen">
          <div class="lines" data-lines>
            <div class="line"><span class="p">{prompt}</span> make release</div>
            {script.map((line) => <div class="line" set:html={line.html} />)}
            <div class="line"><span class="p">{prompt}</span> <span class="cursor"></span></div>
          </div>
        </div>
        <div class="status">
          <span class="problem" data-problem hidden>Reconnecting</span>
          <span class="place">~/src/api · make</span>
          <span class="lock"><Icon name="lock-simple" size={12} /> End-to-end encrypted</span>
        </div>
      </div>
      <aside class="people">
        <div class="people-head">
          <span>People <span class="muted">{people.length}</span></span>
          <Icon name="x" size={14} class="muted" />
        </div>
        <ul>
          {
            people.map((p) => (
              <li>
                <span class="tile">{p.letter}</span>
                <span class="who">
                  <span class="who-name">
                    {p.name}
                    <span class="online" />
                  </span>
                  <span class="who-role">{p.role}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
  <figcaption class="caption">
    <span>
      Wi‑Fi drops mid-build. The build keeps running, and you see what you missed when you’re back.
    </span>
    <button class="replay" data-replay type="button">Play again</button>
  </figcaption>
</figure>

<script>
  type Line = { html: string; gap?: number; missed?: boolean }
  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))

  document.querySelectorAll<HTMLElement>("[data-room]").forEach((room) => {
    const prompt = room.dataset.prompt!
    const script: Line[] = JSON.parse(room.dataset.script!)
    const lines = room.querySelector<HTMLElement>("[data-lines]")!
    const problem = room.querySelector<HTMLElement>("[data-problem]")!
    const replay = room.closest("figure")!.querySelector<HTMLButtonElement>("[data-replay]")!
    // Reduced motion keeps the finished screen that is already rendered.
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      replay.hidden = true
      return
    }
    let run = 0
    const add = (html: string, className = "") => {
      const el = document.createElement("div")
      el.className = `line ${className}`
      el.innerHTML = html
      lines.append(el)
      return el
    }
    const setDown = (down: boolean) => {
      room.classList.toggle("is-down", down)
      problem.hidden = !down
    }

    async function play() {
      const id = ++run
      const alive = () => id === run
      lines.replaceChildren()
      setDown(false)
      const first = add(`<span class="p">${prompt}</span> <span data-typed></span><span class="cursor"></span>`)
      const typed = first.querySelector<HTMLElement>("[data-typed]")!
      await sleep(600)
      for (const char of "make release") {
        if (!alive()) return
        typed.textContent += char
        await sleep(55 + Math.random() * 60)
      }
      await sleep(350)
      first.querySelector(".cursor")?.remove()
      const missed: Line[] = []
      for (const entry of script) {
        if (!alive()) return
        if (entry.missed) {
          if (!missed.length) setDown(true)
          missed.push(entry)
          continue
        }
        if (missed.length) {
          await sleep(2800)
          if (!alive()) return
          setDown(false)
          for (const line of missed) add(line.html, "replayed")
          missed.length = 0
        }
        await sleep(entry.gap ?? 400)
        if (!alive()) return
        add(entry.html)
      }
      await sleep(300)
      if (alive()) add(`<span class="p">${prompt}</span> <span class="cursor"></span>`)
    }

    replay.addEventListener("click", play)
    new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        observer.disconnect()
        play()
      },
      { threshold: 0.55 },
    ).observe(room)
  })
</script>

<style>
  .room-figure {
    display: grid;
    gap: 16px;
  }

  .room {
    overflow: hidden;
    border-radius: 14px;
    background: var(--background);
    box-shadow: 0 0 0 1px var(--rule), var(--shadow-frame);
    font-size: 14px;
    color: var(--ink);
    user-select: none;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 48px;
    padding-inline: 16px 10px;
    border-bottom: 1px solid var(--rule);
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    color: var(--fog);
    white-space: nowrap;
  }

  .crumbs :global(.crumb-mark) {
    color: var(--ink);
    flex-shrink: 0;
  }

  .crumbs :global(.crumb-sep) {
    color: var(--faint);
    flex-shrink: 0;
  }

  .crumb.current {
    color: var(--ink);
    font-weight: 500;
  }

  .actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .tool {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    color: var(--fog);
  }

  .divider {
    width: 1px;
    height: 20px;
    margin-inline: 6px;
    background: var(--rule);
  }

  .people-toggle {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 10px 0 4px;
    border-radius: 6px;
    background: var(--surface-strong);
  }

  .stack {
    display: flex;
  }

  .stack .tile {
    box-shadow: 0 0 0 2px var(--surface-strong);
  }

  .stack .tile + .tile {
    margin-left: -4px;
  }

  .tile {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border-radius: 6px;
    background: #e3eafd;
    color: var(--cobalt);
    font-size: 11px;
    font-weight: 600;
  }

  .count {
    color: var(--fog);
  }

  .share {
    margin-left: 4px;
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding-inline: 12px;
    border-radius: 8px;
    background: var(--cobalt);
    color: #fff;
    font-weight: 500;
  }

  .body {
    display: flex;
    height: 460px;
  }

  /* Paperboat Dark (paperboat-console/lib/terminal/themes.ts). */
  .term {
    --bg: #121212;
    --fg: #f5f5f5;
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--fg);
  }

  .screen {
    flex: 1;
    min-height: 0;
    padding: 16px 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    transition: opacity 0.4s ease;
  }

  .is-down .screen {
    opacity: 0.4;
  }

  .lines {
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.65;
    white-space: pre;
  }

  .lines :global(.p) {
    color: #a8c4fe;
  }

  .lines :global(.g) {
    color: #22c373;
  }

  .lines :global(.b) {
    color: #4275f8;
  }

  .lines :global(.dim) {
    color: #808080;
  }

  .lines :global(.replayed) {
    animation: replayed 1.6s ease-out;
  }

  @keyframes replayed {
    from {
      background: rgb(66 117 248 / 0.3);
    }
    to {
      background: transparent;
    }
  }

  .lines :global(.cursor) {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    vertical-align: -0.2em;
    background: #4275f8;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .status {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 28px;
    flex-shrink: 0;
    padding-inline: 12px;
    border-top: 1px solid rgb(245 245 245 / 0.1);
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgb(245 245 245 / 0.6);
  }

  .problem {
    color: #f7ac4d;
  }

  .place {
    flex: 1;
    min-width: 0;
  }

  .lock {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .is-down .lock {
    visibility: hidden;
  }

  .people {
    display: none;
    width: 300px;
    flex-shrink: 0;
    flex-direction: column;
    border-left: 1px solid var(--rule);
  }

  .people-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 44px;
    padding-inline: 16px 14px;
    border-bottom: 1px solid var(--divider);
    font-weight: 500;
  }

  .muted,
  .people-head :global(.muted) {
    color: var(--fog);
    font-weight: 400;
  }

  .people li {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 56px;
    padding-inline: 16px;
    border-bottom: 1px solid var(--divider);
  }

  .who {
    display: grid;
    min-width: 0;
  }

  .who-name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
    line-height: 1.3;
  }

  .online {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--success);
  }

  .who-role {
    font-size: 12.5px;
    color: var(--fog);
  }

  .caption {
    display: flex;
    gap: 24px;
    align-items: baseline;
    justify-content: space-between;
    font-size: 0.875rem;
    color: var(--fog);
  }

  .replay {
    flex-shrink: 0;
    color: var(--ink);
    font-size: 0.875rem;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
  }

  .replay:hover {
    text-decoration-color: currentColor;
  }

  @media (min-width: 960px) {
    .people {
      display: flex;
    }
  }

  @media (max-width: 760px) {
    .hide-md {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .room :global(.hide-sm),
    .lock {
      display: none;
    }

    .body {
      height: 340px;
    }

    .lines {
      font-size: 10.5px;
    }

    .screen {
      padding: 12px;
    }
  }
</style>
