---
/** Every feature in one hairline grid: its icon, its name and what it gets you, linking to its page. */
import Icon from "./Icon.astro"
import { features } from "../features"
---

<ul class="grid">
  {
    features.map((item) => (
      <li>
        <a href={`/features/${item.slug}/`}>
          <Icon name={item.icon} size={22} class="icon" />
          <span class="name">{item.name}</span>
          <span class="line">{item.line}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    border-radius: var(--radius-lg);
    box-shadow: 0 0 0 1px var(--rule);
    background: var(--paper);
    overflow: hidden;
  }

  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  li {
    display: grid;
    min-width: 0;
    /* Every cell draws its right and bottom line; the frame's own edge hides the outer ones. */
    box-shadow:
      1px 0 0 var(--rule),
      0 1px 0 var(--rule);
  }

  a {
    display: grid;
    align-content: start;
    gap: var(--s2);
    padding: var(--s6) var(--s5) var(--s6) var(--s6);
    transition: background-color 0.15s ease;
  }

  a:hover {
    background: var(--surface);
  }

  a :global(.icon) {
    margin-bottom: var(--s3);
    color: var(--cobalt);
  }

  .name {
    font-size: var(--text-card);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
    white-space: nowrap;
  }

  .line {
    font-size: var(--text-ui);
    line-height: 1.55;
    color: var(--fog);
    text-wrap: pretty;
  }
</style>
