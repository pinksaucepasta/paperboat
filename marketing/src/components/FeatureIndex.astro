---
/** Every feature, in its group: an icon, the name and what it gets you, linking to its page. */
import Icon from "./Icon.astro"
import { featureGroups, features } from "../features"
---

<div class="groups">
  {
    featureGroups.map((group) => (
      <section class="group" aria-label={group}>
        <h3 class="group-title">{group}</h3>
        <ul>
          {features
            .filter((item) => item.group === group)
            .map((item) => (
              <li>
                <a href={`/features/${item.slug}/`}>
                  <Icon name={item.icon} size={20} class="icon" />
                  <span class="name">{item.name}</span>
                  <span class="line">{item.line}</span>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .groups {
    display: grid;
    gap: var(--s7) var(--s7);
  }

  @media (min-width: 900px) {
    .groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .group-title {
    padding-bottom: var(--s3);
    border-bottom: 1px solid var(--rule);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--fog);
  }

  a {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    column-gap: var(--s3);
    row-gap: 2px;
    padding-block: var(--s4);
    border-bottom: 1px solid var(--rule);
  }

  a :global(.icon) {
    grid-row: 1 / span 2;
    margin-top: 2px;
    color: var(--cobalt);
  }

  .name {
    font-weight: 500;
    color: var(--ink);
  }

  a:hover .name {
    color: var(--cobalt);
  }

  .line {
    font-size: var(--text-ui);
    line-height: 1.5;
    color: var(--fog);
  }
</style>
