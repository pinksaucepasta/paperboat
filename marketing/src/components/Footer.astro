---
import Lockup from "./Lockup.astro"
import { footerColumns, legalLinks } from "../nav"
---

<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <Lockup />
      <p>Work on every machine as if it were this one.</p>
    </div>
    {
      footerColumns.map((column) => (
        <nav aria-label={column.title}>
          <h2 class="column-title">{column.title}</h2>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="wrap">
    <div class="footer-base">
    <p>© 2026 Paperboat</p>
    <nav aria-label="Legal">
      <ul class="legal">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(56px, 7vw, 88px) var(--s6);
    border-top: 1px solid var(--rule);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s7) var(--s5);
  }

  .footer-brand {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--s3);
    align-content: start;
  }

  .footer-brand p {
    max-width: 32ch;
    font-size: var(--text-ui);
    color: var(--fog);
  }

  .column-title {
    margin-bottom: var(--s3);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--ink);
  }

  ul {
    display: grid;
    gap: 2px;
  }

  /* Each link is a full-height row, so a thumb can hit it. */
  ul a {
    display: flex;
    align-items: center;
    min-height: 32px;
    font-size: var(--text-ui);
    color: var(--fog);
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  ul a:hover {
    color: var(--ink);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3) var(--s6);
    margin-top: clamp(48px, 6vw, 72px);
    padding-top: var(--s5);
    border-top: 1px solid var(--rule);
    font-size: var(--text-small);
    color: var(--fog);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s5);
  }

  .legal a {
    min-height: 32px;
    font-size: var(--text-small);
  }

  @media (min-width: 720px) {
    .footer-inner {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .footer-inner {
      grid-template-columns: minmax(0, 2fr) repeat(4, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: auto;
    }

    ul a {
      min-height: 28px;
    }
  }
</style>
