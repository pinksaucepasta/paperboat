---
import Lockup from "./Lockup.astro"
import { footerColumns } from "../nav"
---

<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <Lockup />
      <p class="small">Work on every machine as if it were this one.</p>
    </div>
    {
      footerColumns.map((column) => (
        <nav aria-label={column.title}>
          <h2 class="column-title">{column.title}</h2>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="wrap">
    <p class="footer-base small">© 2026 Paperboat</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--s8) var(--s6);
    border-top: 1px solid var(--rule);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s7) var(--s5);
  }

  .footer-brand {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--s3);
    align-content: start;
    max-width: 30ch;
  }

  .column-title {
    margin-bottom: var(--s2);
    font-family: var(--font-sans);
    font-size: var(--text-ui);
    font-weight: 500;
    color: var(--ink);
  }

  /* Each link is a full-height row, so a thumb can hit it. */
  ul a {
    display: flex;
    align-items: center;
    min-height: 36px;
    white-space: nowrap;
    font-size: var(--text-ui);
    line-height: 1.3;
    color: var(--fog);
  }

  ul a:hover {
    color: var(--ink);
  }

  .footer-base {
    margin-top: var(--s8);
    padding-top: var(--s5);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 640px) {
    .footer-inner {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .footer-inner {
      grid-template-columns: 1.3fr repeat(4, minmax(0, 1fr));
      gap: var(--s6);
    }

    .footer-brand {
      grid-column: auto;
    }

    ul a {
      min-height: 30px;
    }
  }
</style>
