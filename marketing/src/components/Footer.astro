---
import Lockup from "./Lockup.astro"
import { navGroups, getStartedLinks, legalLinks } from "../nav"
// Groups with links become columns; single links (Pricing) share one column.
const columns = [
  ...navGroups
    .filter((group) => group.links.length)
    .map((group) => ({
      title: group.title,
      links: group.href ? [{ href: group.href, label: "Overview" }, ...group.links] : group.links,
    })),
  {
    title: "Get started",
    links: [
      ...navGroups.filter((group) => !group.links.length).map((group) => ({ href: group.href!, label: group.title })),
      ...getStartedLinks,
    ],
  },
  { title: "Legal", links: legalLinks },
]
---

<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand"><Lockup /></div>
    {
      columns.map((group) => (
        <nav aria-label={group.title}>
          <div class="group-title">{group.title}</div>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="wrap">
    <div class="footer-base">© 2026 Paperboat</div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 64px 32px;
    font-size: 0.875rem;
  }

  .footer-inner {
    display: grid;
    gap: 40px;
  }

  .footer-brand {
    align-self: start;
  }

  .group-title {
    color: var(--ink);
    font-weight: 500;
    margin-bottom: 12px;
  }

  ul {
    display: grid;
    gap: 8px;
  }

  ul a {
    color: var(--fog);
  }

  ul a:hover {
    color: var(--ink);
  }

  .footer-base {
    margin-top: 64px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    color: var(--fog);
  }

  @media (min-width: 760px) {
    .footer-inner {
      grid-template-columns: 2fr repeat(4, 1fr);
    }
  }
</style>
