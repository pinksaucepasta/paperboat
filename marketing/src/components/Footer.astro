---
import Lockup from "./Lockup.astro"
import { consoleUrl } from "../site"
const groups = [
  {
    title: "Product",
    links: [
      { href: "/#terminals", label: "Terminals" },
      { href: "/#links", label: "Previews and tunnels" },
      { href: "/#teams", label: "Teams" },
      { href: "/#network", label: "Network" },
      { href: "/pricing", label: "Pricing" },
    ],
  },
  {
    title: "Get started",
    links: [
      { href: "/#install", label: "Install" },
      { href: consoleUrl, label: "Console" },
    ],
  },
]
---

<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand"><Lockup /></div>
    {
      groups.map((group) => (
        <nav aria-label={group.title}>
          <div class="group-title">{group.title}</div>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="wrap">
    <div class="footer-base">© 2026 Paperboat</div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 64px 32px;
    font-size: 0.875rem;
  }

  .footer-inner {
    display: grid;
    gap: 40px;
  }

  .footer-brand {
    align-self: start;
  }

  .group-title {
    color: var(--ink);
    font-weight: 500;
    margin-bottom: 12px;
  }

  ul {
    display: grid;
    gap: 8px;
  }

  ul a {
    color: var(--fog);
  }

  ul a:hover {
    color: var(--ink);
  }

  .footer-base {
    margin-top: 64px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    color: var(--fog);
  }

  @media (min-width: 760px) {
    .footer-inner {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
</style>
