---
import Section from "./Section.astro"
import Icon from "./Icon.astro"
import { featureRows, planNames, bandwidthRow } from "../pricing-data"
---

<Section id="compare-plans" title="What each plan includes" tone="surface">
  <Fragment slot="text">
    <p>Where the plans differ.</p>
  </Fragment>
  <div class="table-scroll">
    <table class="plans-table">
      <thead>
        <tr>
          <th scope="col"><span class="visually-hidden">Feature</span></th>
          {planNames.map((name) => <th scope="col">{name}</th>)}
        </tr>
      </thead>
      <tbody>
        <tr class="bandwidth-row">
          <th scope="row">Relay and edge bandwidth a month</th>
          {bandwidthRow.map((value) => <td>{value}</td>)}
        </tr>
        {
          featureRows.map((row) => (
            <tr>
              <th scope="row">{row.feature}</th>
              {row.cells.map((cell) => (
                <td>
                  {cell === true ? (
                    <>
                      <Icon name="check" size={18} class="yes" />
                      <span class="visually-hidden">Included</span>
                    </>
                  ) : cell === false ? (
                    <span class="no">
                      —<span class="visually-hidden">Not included</span>
                    </span>
                  ) : (
                    <span class:list={[cell === "Coming" && "coming"]}>{cell}</span>
                  )}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Section>

<style>
  .table-scroll {
    overflow-x: auto;
  }

  .plans-table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th,
  td {
    padding: 14px 16px;
    text-align: left;
    border-bottom: 1px solid var(--rule);
  }

  thead th {
    font-family: var(--font-brand);
    font-weight: 600;
    color: var(--ink);
  }

  tbody th {
    font-weight: 400;
    color: var(--text);
  }

  td {
    color: var(--ink);
  }

  .bandwidth-row th,
  .bandwidth-row td {
    font-weight: 500;
    color: var(--ink);
  }

  .plans-table .no,
  .plans-table .coming {
    color: var(--fog);
  }

  .plans-table :global(.yes) {
    color: var(--success);
  }
</style>
