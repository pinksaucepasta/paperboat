---
/** A section: a short title and a line or two under it, then whatever shows it. */
interface Props {
  id: string
  /** Left out, the section is just its content (the benefits block has no heading). */
  title?: string
  tone?: "plain" | "surface"
}
const { id, title, tone = "plain" } = Astro.props
---

<section class:list={["section", `section-${tone}`]} id={id} aria-labelledby={title ? `${id}-title` : undefined}>
  <div class="wrap">
    {
      title && (
        <header class="section-head">
          <h2 class="title" id={`${id}-title`}>{title}</h2>
          <div class="lede section-text"><slot name="text" /></div>
        </header>
      )
    }
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: clamp(64px, 7vw, 96px);
  }

  .section-surface {
    background: var(--surface);
  }

  .section-head {
    display: grid;
    gap: 18px;
    max-width: 640px;
    margin-bottom: clamp(40px, 5vw, 56px);
  }

  .section-text {
    display: grid;
    gap: 12px;
  }
</style>
