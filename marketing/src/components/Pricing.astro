---
import Section from "./Section.astro"
import { plans, teamTrial } from "../site"
---

<Section id="pricing" title="Free to start">
  <Fragment slot="text">
    <p>
      Every plan has every feature. Plans differ in limits and bandwidth. Team adds people. Direct traffic between your machines is always free.
    </p>
  </Fragment>
  <div class="plans">
    {
      plans.map((plan) => (
        <article class="plan surface-pattern">
          <h3 class="subtitle">{plan.name}</h3>
          <p class="price">
            {plan.price}
            {plan.period && <span class="period">{plan.period}</span>}
          </p>
          <p class="bandwidth">{plan.bandwidth} of relay and edge bandwidth a month</p>
          <p class="body">{plan.detail}</p>
          <ul class="limits">
            <li><strong>{plan.machines}</strong> machines</li>
            <li><strong>{plan.publications}</strong> live previews and tunnels</li>
            <li><strong>{plan.browserTerminals}</strong> live browser terminals</li>
            <li><strong>{plan.nativeTerminals}</strong> terminals from the pb command</li>
          </ul>
        </article>
      ))
    }
  </div>
  <p class="trial">{teamTrial}</p>
</Section>

<style>
  .limits {
    display: grid;
    gap: 8px;
    margin-top: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
    color: var(--fog);
  }

  .limits strong {
    color: var(--ink);
    font-weight: 500;
  }

  .plans {
    display: grid;
    gap: 16px;
  }

  .plan {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: clamp(24px, 3.2vw, 36px);
  }

  .price {
    font-family: var(--font-brand);
    font-weight: 600;
    font-size: 2rem;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .period {
    font-family: var(--font-body, inherit);
    font-weight: 400;
    font-size: 0.875rem;
    letter-spacing: 0;
    color: var(--fog);
  }

  .bandwidth {
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .plan .body {
    font-size: 1rem;
    max-width: 40ch;
  }

  .trial {
    margin-top: 20px;
    font-size: 0.9375rem;
    color: var(--fog);
    max-width: 70ch;
  }

  @media (min-width: 860px) {
    .plans {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
