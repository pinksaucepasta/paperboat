---
import Section from "./Section.astro"
import { compare, plans, teamTrial } from "../site"
---

<Section id="pricing" title="Free to start.">
  <Fragment slot="text">
    <p>
      Free and Pro have everything one person needs, with unlimited machines, previews and tunnels. Direct
      traffic is always free; the only limit is how much goes through our relays and edges each month. Sharing a
      terminal session or a preview link is free on every plan. Team adds people.
    </p>
  </Fragment>
  <div class="plans">
    {
      plans.map((plan) => (
        <article class="plan surface-pattern">
          <h3 class="subtitle">{plan.name}</h3>
          <p class="price">
            {plan.price}
            {plan.period && <span class="period">{plan.period}</span>}
          </p>
          <p class="bandwidth">{plan.bandwidth} of relay and edge bandwidth a month</p>
          <p class="body">{plan.detail}</p>
        </article>
      ))
    }
  </div>
  <p class="trial">{teamTrial}</p>
  <table class="compare">
    <thead>
      <tr><th scope="col"><span class="sr">Feature</span></th><th scope="col">Free</th><th scope="col">Pro</th><th scope="col">Team</th></tr>
    </thead>
    <tbody>
      {
        compare.map((row) => (
          <tr>
            <th scope="row">{row.feature}</th>
            {[row.free, row.pro, row.team].map((cell) => (
              <td class={cell === "Coming" ? "coming" : undefined}>
                {cell === true ? "Included" : cell === false ? "—" : cell}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</Section>

<style>
  .plans {
    display: grid;
    gap: 16px;
  }

  .plan {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: clamp(24px, 3.2vw, 36px);
  }

  .price {
    font-family: var(--font-brand);
    font-weight: 600;
    font-size: 2rem;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .period {
    font-family: var(--font-body, inherit);
    font-weight: 400;
    font-size: 0.875rem;
    letter-spacing: 0;
    color: var(--fog);
  }

  .bandwidth {
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .plan .body {
    font-size: 1rem;
    max-width: 40ch;
  }

  .trial {
    margin-top: 20px;
    font-size: 0.9375rem;
    color: var(--fog);
    max-width: 70ch;
  }

  .compare {
    width: 100%;
    margin-top: 40px;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .compare th,
  .compare td {
    padding: 12px 8px;
    text-align: left;
    border-bottom: 1px solid var(--rule);
  }

  .compare thead th {
    font-family: var(--font-brand);
    font-weight: 600;
    color: var(--ink);
  }

  .compare tbody th {
    font-weight: 400;
    color: var(--ink);
  }

  .compare td {
    color: var(--fog);
    width: 18%;
  }

  .compare td.coming {
    font-style: italic;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (min-width: 860px) {
    .plans {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
