---
import Install from "./Install.astro"
import Mark from "./Mark.astro"
/** The last thing on a page: the boat, one line, and the install command. */
interface Props {
  title?: string
}
const { title = "Install pb on the machine in front of you" } = Astro.props
---

<section class="closing section-rule" aria-labelledby="closing-title">
  <div class="wrap closing-inner">
    <Mark height={48} class="closing-mark" />
    <h2 class="h2 closing-title" id="closing-title">{title}</h2>
    <p class="closing-lede">Free for personal use. No card needed.</p>
    <div class="closing-install"><Install /></div>
  </div>
</section>

<style>
  .closing {
    padding-block: clamp(88px, 10vw, 144px);
  }

  .closing-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: var(--s5);
    text-align: center;
  }

  .closing :global(.closing-mark) {
    margin-bottom: var(--s3);
    color: var(--cobalt);
  }

  .closing-title {
    max-width: 18ch;
  }

  .closing-lede {
    max-width: 46ch;
    font-size: var(--text-lede);
    color: var(--fog);
    text-wrap: balance;
  }

  .closing-install {
    width: 100%;
    max-width: 560px;
    margin-top: var(--s3);
  }

  .closing-install :global(.install),
  .closing-install :global(.os-panel) {
    justify-items: center;
  }
</style>
