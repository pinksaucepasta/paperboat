---
import Install from "./Install.astro"
/** The last section of a page: one line on the left, the install command on the right. */
interface Props {
  title?: string
}
const { title = "Start with the machine in front of you" } = Astro.props
---

<section class="section section-rule closing" aria-labelledby="closing-title">
  <div class="wrap closing-inner">
    <div class="closing-text">
      <h2 class="h2" id="closing-title">{title}</h2>
      <p>Install Paperboat here, then on a second machine. Free for personal use, no card needed.</p>
    </div>
    <div class="closing-install"><Install /></div>
  </div>
</section>

<style>
  .closing-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s6) var(--s8);
    align-items: end;
  }

  .closing-text {
    display: grid;
    gap: var(--s4);
  }

  .closing-text .h2 {
    max-width: 18ch;
  }

  .closing-text p {
    max-width: 44ch;
    color: var(--fog);
  }

  @media (min-width: 960px) {
    .closing-inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
    }
  }
</style>
