---
import Lockup from "./Lockup.astro"
import Icon from "./Icon.astro"
import { consoleUrl } from "../site"
import { navGroups } from "../nav"
---

<header class="nav">
  <div class="wrap nav-inner">
    <Lockup />
    <nav class="nav-links" aria-label="Main">
      {
        navGroups.map((group) =>
          group.links.length && !group.href ? (
            <div class="group">
              <button type="button" class="group-title" aria-haspopup="true">
                {group.title}
                <Icon name="caret-down" size={12} />
              </button>
              <div class="menu">
                {group.links.map((link) => (
                  <a href={link.href}>{link.label}</a>
                ))}
              </div>
            </div>
          ) : (
            <a class="group-title" href={group.href}>
              {group.title}
            </a>
          ),
        )
      }
    </nav>
    <details class="mobile-menu">
      <summary aria-label="Menu"><Icon name="list" size={22} /></summary>
      <nav class="mobile-panel" aria-label="Menu">
        {
          navGroups.map((group) =>
            group.links.length && !group.href ? (
              <div class="mobile-group">
                <div class="mobile-title">{group.title}</div>
                {group.links.map((link) => (
                  <a href={link.href}>{link.label}</a>
                ))}
              </div>
            ) : (
              <a class="mobile-title" href={group.href}>
                {group.title}
              </a>
            ),
          )
        }
      </nav>
    </details>
    <div class="nav-actions">
      <a class="nav-signin" href={consoleUrl}>Sign in</a>
      <a class="button button-primary nav-cta" href="/#install">Install</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header);
    background: rgb(255 255 255 / 0.86);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    box-shadow: 0 1px 0 var(--rule);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    height: 100%;
  }

  .nav-links {
    display: none;
    gap: 28px;
    margin-left: 40px;
    font-size: 0.9375rem;
    color: var(--fog);
  }

  .nav-links {
    align-items: center;
  }

  .group {
    position: relative;
  }

  .group-title {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: var(--header);
    font-size: inherit;
    color: inherit;
  }

  /* The menu opens on hover and on keyboard focus, with no script. */
  .menu {
    position: absolute;
    top: calc(100% - 8px);
    left: -14px;
    display: none;
    min-width: 240px;
    padding: 8px;
    background: var(--background);
    border-radius: var(--radius);
    box-shadow: var(--shadow-frame);
  }

  .group:hover .menu,
  .group:focus-within .menu {
    display: grid;
  }

  .menu a {
    padding: 8px 12px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .menu a:hover {
    background: var(--surface);
  }

  .nav-links .group-title:hover,
  .group:hover .group-title,
  .nav-links a:hover,
  .nav-signin:hover {
    color: var(--ink);
  }

  .nav-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-signin {
    font-size: 0.9375rem;
    color: var(--fog);
  }

  .nav-cta {
    height: 34px;
    padding-inline: 14px;
  }

  /* On a phone the groups live behind a menu button; it opens without script. */
  .mobile-menu {
    margin-left: auto;
    order: 3;
  }

  .mobile-menu summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-left: 4px;
    cursor: pointer;
    list-style: none;
    color: var(--ink);
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-panel {
    position: absolute;
    top: var(--header);
    left: 0;
    right: 0;
    display: grid;
    gap: 4px;
    padding: 12px var(--gutter) 20px;
    background: var(--background);
    box-shadow: 0 1px 0 var(--rule), 0 24px 40px -24px rgb(16 24 64 / 0.18);
    font-size: 1rem;
  }

  .mobile-group {
    display: grid;
    padding-bottom: 8px;
  }

  .mobile-title {
    padding: 10px 0;
    color: var(--ink);
    font-weight: 500;
  }

  .mobile-panel a:not(.mobile-title) {
    padding: 8px 0 8px 12px;
    color: var(--fog);
  }

  .nav-actions {
    margin-left: auto;
  }

  .mobile-menu {
    margin-left: 0;
  }

  @media (min-width: 860px) {
    .nav-links {
      display: flex;
    }

    .mobile-menu {
      display: none;
    }
  }
</style>
