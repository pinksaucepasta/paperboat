---
import Lockup from "./Lockup.astro"
import Icon from "./Icon.astro"
import { consoleUrl } from "../site"
import { navGroups } from "../nav"
---

<header class="nav">
  <div class="wrap nav-inner">
    <Lockup />
    <nav class="nav-links" aria-label="Main">
      {
        navGroups.map((group) =>
          group.links.length ? (
            <div class="group">
              <button type="button" class="group-title" aria-haspopup="true">
                {group.title}
                <Icon name="caret-down" size={12} />
              </button>
              <div class="menu">
                {group.links.map((link) => (
                  <a href={link.href}>{link.label}</a>
                ))}
              </div>
            </div>
          ) : (
            <a class="group-title" href={group.href}>
              {group.title}
            </a>
          ),
        )
      }
    </nav>
    <div class="nav-actions">
      <a class="nav-signin" href={consoleUrl}>Sign in</a>
      <a class="button button-primary nav-cta" href="/#install">Install</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header);
    background: rgb(255 255 255 / 0.86);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    box-shadow: 0 1px 0 var(--rule);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    height: 100%;
  }

  .nav-links {
    display: none;
    gap: 28px;
    margin-left: 40px;
    font-size: 0.9375rem;
    color: var(--fog);
  }

  .nav-links {
    align-items: center;
  }

  .group {
    position: relative;
  }

  .group-title {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: var(--header);
    font-size: inherit;
    color: inherit;
  }

  /* The menu opens on hover and on keyboard focus, with no script. */
  .menu {
    position: absolute;
    top: calc(100% - 8px);
    left: -14px;
    display: none;
    min-width: 240px;
    padding: 8px;
    background: var(--background);
    border-radius: var(--radius);
    box-shadow: var(--shadow-frame);
  }

  .group:hover .menu,
  .group:focus-within .menu {
    display: grid;
  }

  .menu a {
    padding: 8px 12px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .menu a:hover {
    background: var(--surface);
  }

  .nav-links .group-title:hover,
  .group:hover .group-title,
  .nav-links a:hover,
  .nav-signin:hover {
    color: var(--ink);
  }

  .nav-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-signin {
    font-size: 0.9375rem;
    color: var(--fog);
  }

  .nav-cta {
    height: 34px;
    padding-inline: 14px;
  }

  @media (min-width: 860px) {
    .nav-links {
      display: flex;
    }
  }
</style>
