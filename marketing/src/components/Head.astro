---
/**
 * The top of an inner page: a small label naming where you are, the page's one h1, one or two
 * sentences, optional buttons, and beside them (slot "aside") the thing itself.
 */
interface Props {
  title: string
  /** A short label above the title: the feature or section the page belongs to. */
  eyebrow?: string
  /** Where the eyebrow links, e.g. "/features/". */
  eyebrowHref?: string
  /** Show the "Get started" and docs buttons under the introduction. */
  actions?: boolean
}
const { title, eyebrow, eyebrowHref, actions = false } = Astro.props
const hasAside = Astro.slots.has("aside")
---

<section class="head">
  <div class:list={["wrap", "head-inner", { "head-split": hasAside }]}>
    <div class="head-text">
      {eyebrow && (eyebrowHref ? <a class="eyebrow" href={eyebrowHref}>{eyebrow}</a> : <p class="eyebrow">{eyebrow}</p>)}
      <h1 class="h1">{title}</h1>
      <div class="lede head-lede"><slot /></div>
      {
        actions && (
          <div class="head-actions">
            <a class="button button-primary" href="#get-started">Get started free</a>
            <a class="button button-quiet" href="/docs/">Read the docs</a>
          </div>
        )
      }
      <slot name="actions" />
    </div>
    {hasAside && <div class="head-aside"><slot name="aside" /></div>}
  </div>
</section>

<style>
  .head {
    padding-block: clamp(56px, 7vw, 104px) clamp(64px, 7vw, 104px);
  }

  .head-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s7);
  }

  .head-text {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s5);
    align-content: start;
    justify-items: start;
    max-width: 46rem;
  }

  .head-lede {
    display: grid;
    gap: var(--s3);
  }

  .eyebrow {
    font-size: var(--text-ui);
    font-weight: 500;
    color: var(--cobalt);
  }

  a.eyebrow:hover {
    color: var(--deep);
  }

  .head-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin-top: var(--s2);
  }

  .head-aside {
    min-width: 0;
  }

  @media (min-width: 1100px) {
    .head-split {
      grid-template-columns: minmax(0, 11fr) minmax(0, 12fr);
      column-gap: var(--s8);
      align-items: center;
    }

    .head-split .h1 {
      font-size: var(--text-h1-split);
    }
  }
</style>
