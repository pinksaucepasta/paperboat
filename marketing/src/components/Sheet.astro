---
/**
 * A terminal window with the commands and what pb prints (formats from cli/cmd/pb). Lines never
 * wrap; a long one scrolls inside the window. Notes are numbered under the window, each number
 * also standing beside the lines it explains.
 */
export type Step = {
  /**
   * The lines, as on screen. "$ pb send a --to b" is a command you type; "ana@studio:~$ make" is a
   * command typed in a shell on another machine; "# ..." is our remark; anything else is output.
   */
  lines: string[]
  /** Said under the window, numbered to match these lines. */
  note?: string
}
interface Props {
  steps: Step[]
  /** Where this is typed, shown in the title bar ("On your laptop"). */
  where?: string
  /** Kept for callers whose output is a table; every window keeps its columns now. */
  table?: boolean
  class?: string
}
const { steps, where, class: className } = Astro.props
const escape = (value: string) => value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
const prompt = /^(\$|[\w.-]+@[\w.-]+:\S*[$#]) (.*)$/
const line = (text: string) => {
  const command = text.match(prompt)
  if (command) return `<span class="p">${escape(command[1])}</span> <span class="r">${escape(command[2])}</span>`
  if (text.startsWith("#")) return `<span class="c">${escape(text)}</span>`
  return escape(text).replace(/https:\/\/[^\s)]+/g, (url) => `<span class="u">${url}</span>`)
}
/** One string per step, so no stray whitespace gets inside the <pre>. */
const html = (step: Step) => step.lines.map(line).join("\n")
let count = 0
const numbered = steps.map((step) => ({ ...step, n: step.note ? ++count : 0 }))
const notes = numbered.filter((step) => step.note)
---

<figure class:list={["sheet", className]}>
  <div class="window">
    <div class="bar" aria-hidden={where ? undefined : "true"}>
      {where && <figcaption class="where">{where}</figcaption>}
    </div>
    <div class="rows" tabindex="0">
      {
        numbered.map((step) => (
          <div class="row">
            {step.n > 0 && (
              <span class="num" aria-hidden="true">
                {step.n}
              </span>
            )}
            <pre class="lines"><code set:html={html(step)} /></pre>
          </div>
        ))
      }
    </div>
  </div>
  {
    notes.length > 0 && (
      <ol class:list={["notes", `notes-${Math.min(notes.length, 4)}`]}>
        {notes.map((step) => (
          <li>
            <span class="num">{step.n}</span>
            <p set:html={step.note} />
          </li>
        ))}
      </ol>
    )
  }
</figure>

<style>
  .sheet {
    container-type: inline-size;
    display: grid;
    gap: var(--s5);
    min-width: 0;
  }

  .window {
    min-width: 0;
    border-radius: 12px;
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--rule);
    overflow: hidden;
  }

  .bar {
    display: flex;
    align-items: center;
    height: 40px;
    padding-inline: var(--s5);
    border-bottom: 1px solid var(--rule);
    background: var(--surface);
  }

  .bar:not(:has(.where)) {
    display: none;
  }

  .where {
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    color: var(--fog);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rows {
    display: grid;
    gap: var(--s4);
    padding: var(--s5) 0;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .row {
    position: relative;
    padding-inline: var(--s5);
  }

  .row:has(.num) {
    padding-left: 44px;
  }

  .lines {
    width: max-content;
    min-width: 100%;
    font-size: var(--text-small);
    line-height: 1.85;
    color: var(--text);
    white-space: pre;
  }

  .lines :global(.p) {
    color: var(--cobalt);
    user-select: none;
  }

  .lines :global(.r) {
    color: var(--ink);
    font-weight: 500;
  }

  .lines :global(.u) {
    color: var(--cobalt);
  }

  .lines :global(.c) {
    color: var(--fog);
  }

  .num {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--hull);
    color: var(--cobalt);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    font-weight: 600;
    line-height: 1;
  }

  .row .num {
    position: absolute;
    left: 16px;
    top: 4px;
  }

  .notes {
    display: grid;
    gap: var(--s4) var(--s6);
  }

  .notes li {
    display: flex;
    gap: var(--s3);
    align-items: baseline;
  }

  .notes .num {
    position: relative;
    top: 3px;
  }

  .notes p {
    font-size: var(--text-ui);
    line-height: 1.5;
    color: var(--fog);
    text-wrap: pretty;
  }

  .notes p :global(strong) {
    color: var(--ink);
    font-weight: 500;
  }

  @container (min-width: 480px) {
    .notes-2,
    .notes-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (min-width: 720px) {
    .notes-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @container (min-width: 960px) {
    .notes-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
