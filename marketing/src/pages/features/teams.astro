---
import Feature from "../../layouts/Feature.astro"
import Beat from "../../components/Beat.astro"
import Term from "../../components/Term.astro"
import { addonPrices, addons, auditRetention, plans } from "../../site"

const faq = [
  {
    q: "Does joining a team give someone access to my machines?",
    a: "No. Membership grants nothing by itself. A machine is shared with a team on purpose, and each person's access to it is a rule you can read.",
  },
  {
    q: "Do I need the Team plan for tags, rules and API tokens?",
    a: `No. They work on Free and Pro too, for example to give a CI token nothing but commands on machines tagged ci. Team adds members, roles and audit log export, and single sign-on and directory sync as add-ons (${addonPrices}).`,
  },
  {
    q: "What happens when someone leaves?",
    a: "Remove them, or let directory sync do it. Their open sessions end at once and their team API tokens stop working.",
  },
  {
    q: "Which identity providers work for single sign-on?",
    a: `Any SAML or OpenID Connect provider, including Okta, Microsoft Entra ID and Google Workspace, on a team of any size, as an add-on (SSO $${addons.sso}/mo).`,
  },
  {
    q: "What does the audit log record?",
    a: `Who did what to which machine or setting, whether it was allowed, and from where. Never terminal contents, file contents or secrets. It is kept ${auditRetention[0]} on Free, ${auditRetention[1]} on Pro and ${auditRetention[2]} on Team.`,
  },
  {
    q: "How is a team billed?",
    a: `${plans[2].price} per seat a month, or ${plans[2].yearly} a year, with a 14-day free trial.`,
  },
]
---

<Feature
  slug="teams"
  title="Teams and access rules | Paperboat"
  description="Share machines with your team, one permission at a time, with a policy you can read and an audit log of every action."
  headline="Share machines with your team"
  faq={faq}
  related={["recordings", "ssh", "private-access"]}
  compare={["teleport", "twingate", "enterprise-vpn"]}
>
  <p slot="lede">Give each person exactly what they need on each machine: a terminal here, a database port there. Take it back in one step.</p>
  <Term slot="aside" lines={["$ pb policy explain --src user:maya \\", "    --dst machine:db --action exec", "DENIED: no rule allows it", "", "$ pb policy explain --dst machine:db", "# who can do what on db"]} />

  <Beat id="rules-title" title="Rules you can read">
    <p>Access lives in one short file: groups, tags and rules. Ask why someone can or can't do something, and the answer names the rule.</p>
    <Term
      slot="visual"
      title="policy.json"
      lines={['{', '  "src": ["group:ops"],', '  "dst": ["tag:prod"],', '  "allow": ["terminal", "exec"]', '}']}
    />
  </Beat>

  <Beat id="roles-title" title="Roles for everyone" flip>
    <p>Owners, admins, billing, auditors and members. Each sees what their job needs, and nothing more.</p>
    <Term slot="visual" lines={["$ pb team invite acme maya@acme.com \\", "    --generation 7", "$ pb team role acme maya@acme.com auditor \\", "    --generation 8"]} />
  </Beat>

  <Beat id="audit-title" title="Every action in the log">
    <p>Who opened a terminal, sent a file or changed a rule, and whether it was allowed. Export it, or stream it to your own storage.</p>
    <Term slot="visual" lines={["$ pb team activity acme --since 1h", "09:12  maya  terminal  staging  success", "09:14  maya  exec      db       denied"]} />
  </Beat>

  <section class="section section-rule" aria-labelledby="details-title">
    <div class="wrap">
      <h2 class="visually-hidden" id="details-title">Details</h2>
      <div class="points points-3">
        <div>
          <h3 class="h3">One permission at a time</h3>
          <p>Terminal, commands, SSH, files, previews, tunnels and ports are separate permissions.</p>
        </div>
        <div>
          <h3 class="h3">Single sign-on</h3>
          <p>SAML or OpenID Connect, with directory sync, as add-ons: {addonPrices}.</p>
        </div>
        <div>
          <h3 class="h3">Tokens for machines</h3>
          <p>API tokens that expire and can do only what you allow, for CI and agents.</p>
        </div>
      </div>
    </div>
  </section>
</Feature>
