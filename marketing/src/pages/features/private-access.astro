---
import Feature from "../../layouts/Feature.astro"
import Beat from "../../components/Beat.astro"
import Term from "../../components/Term.astro"
import Addresses from "../../components/Addresses.astro"
import { localDomain } from "../../site"

const addresses: [string, string][] = [
  [`3000.studio.${localDomain}`, "Port 3000 on studio"],
  [`grafana.homelab.${localDomain}`, "A port you named"],
  [`jellyfin.${localDomain}`, "A short name of its own"],
  [`studio.${localDomain}`, "Everything studio serves"],
]

const faq = [
  {
    q: "Who can open these addresses?",
    a: "Only you, from your own machines. A teammate can open them only if a rule gives them that machine and those ports.",
  },
  {
    q: "Which ports can I reach?",
    a: "On your own machines, the ports your user listens on from 1024 up, plus 80 and 443, are found by themselves. Any other port is one rule away.",
  },
  {
    q: "Does it change my DNS, hosts file or VPN?",
    a: `No. The ${localDomain} names point at your own computer, where Paperboat answers. Nothing on your network changes, and it runs next to any VPN.`,
  },
  {
    q: "How do I reach an app behind Coolify, Traefik or Caddy?",
    a: `Give the app a domain like <code>jellyfin.homelab.${localDomain}</code>. Paperboat sends names it doesn't know to the machine's reverse proxy on port 80, and the proxy picks the app. <code>pb port front-desk homelab 443 https</code> changes the port.`,
  },
  {
    q: "What about databases and other TCP services?",
    a: "Each machine also has its own local address. Point any client at it, on any port: psql, redis-cli, a game client.",
  },
]
---

<Feature
  slug="private-access"
  title="Private HTTPS addresses for every port | Paperboat"
  description="Open a database or dev server on another machine as if it were local. Nothing is published to the internet."
  headline="Every port, its own private address"
  faq={faq}
  related={["previews", "ssh", "teams"]}
  compare={["tailscale", "netbird", "zerotier"]}
>
  <p slot="lede">
    The dev server on your desktop, Grafana on the box at home, the admin page on staging. Open any of them by name, with real HTTPS, from any of
    your machines.
  </p>
  <Addresses slot="aside" rows={addresses} />

  <Beat id="names-title" title="Give a port a name">
    <p>
      Name a port once and the name works on every computer you and your team use. Want it shorter? Give it a name of its own:
      <code>jellyfin.{localDomain}</code> opens the same app as <code>jellyfin.homelab.{localDomain}</code>.
    </p>
    <Term
      slot="visual"
      lines={[
        "$ pb port name set jellyfin 8096 \\",
        "    --machine homelab",
        `# https://jellyfin.homelab.${localDomain}`,
        "$ pb port name set jellyfin 8096 \\",
        "    --machine homelab --top-level",
        `# https://jellyfin.${localDomain}`,
      ]}
    />
  </Beat>

  <Beat id="proxy-title" title="Apps behind Coolify too" flip>
    <p>Running Coolify, Traefik or Caddy? Give each app a name under your machine and it opens like any other.</p>
    <Term slot="visual" title="Coolify, app settings" lines={[`Domain  https://jellyfin.homelab.${localDomain}`]} />
  </Beat>

  <Beat id="tcp-title" title="Databases as if they were local">
    <p>Anything that speaks TCP works too: a database, Redis, SSH. Your client never knows the server is somewhere else.</p>
    <Term slot="visual" lines={["$ pb access machine staging --port 5432 \\", "    --listen 127.0.0.1:5432", "$ psql -h 127.0.0.1 app", "app=>"]} />
  </Beat>

  <section class="section section-rule" aria-labelledby="details-title">
    <div class="wrap">
      <h2 class="visually-hidden" id="details-title">Details</h2>
      <div class="points points-3">
        <div>
          <h3 class="h3">Real HTTPS</h3>
          <p>Your browser trusts the certificate, so cookies, logins and service workers behave.</p>
        </div>
        <div>
          <h3 class="h3">Nothing published</h3>
          <p>No port opens on the internet. The traffic is encrypted between your two machines.</p>
        </div>
        <div>
          <h3 class="h3">Works next to your VPN</h3>
          <p>No network adapter and no DNS change, so it never gets in the way of anything else.</p>
        </div>
      </div>
    </div>
  </section>
</Feature>
