---
import Feature from "../../layouts/Feature.astro"
import Sheet from "../../components/Sheet.astro"
import { plans } from "../../site"

const hero = [
  { lines: ["$ pb machine add --name build-02"], note: "Prints the install line for a new machine. The console's Add machine button gives you the same thing." },
  { lines: ["$ pb environments", "NAME      STATE   PLATFORM      ID", "laptop    online  darwin/arm64  machine_2f6c0b1e-77a4-4c1d-b0f3-5d9a41c8e2a7", "studio    online  linux/amd64   machine_8a1d5c2e-3b47-4f0e-9d62-1c7e5b0a4f93", "build-01  online  linux/arm64   machine_c93e4a70-0d5b-4f8e-8a16-2b7f6e9d3c51"], note: "The list the console's Machines page shows, from the command line." },
]

const pages = [
  ["Machines", "Every machine with its state and tags. Open one for its terminals, files, previews, tunnels and ports."],
  ["Terminals", "Your sessions on any machine, in the browser, end-to-end encrypted. Share one with a join code."],
  ["Previews and tunnels", "What is public right now, when each preview expires, routes and domains. The inspector lists requests live and replays them."],
  ["Domains", "Add a domain, see the DNS records it needs and the state of its certificate."],
  ["Files", "A machine's Inbox: download, remove, approve a teammate's request. Drop a file to send it."],
  ["Environment", "ENV names by scope, and which machines receive them. Values are entered and decrypted in your browser only."],
  ["Config sync", "Repositories, which machines follow them, and conflicts."],
  ["Access", "The policy as a grid or as its file, with review before saving, a test tab and version history."],
  ["Team and activity", "Members, roles, single sign-on and directory sync, and the searchable audit log."],
  ["Network", "Relays and edges with measured latency, and your own self-hosted nodes."],
  ["Usage and billing", "Bandwidth by path (direct, relayed, edge), your limits, plan and invoices."],
  ["Settings", "API tokens, transfer mode, account."],
]

const faq = [
  {
    q: "Do I need the console to use Paperboat?",
    a: "No. Everything the console does, pb does. A few things are easier in a browser: inviting people, reading the audit log, watching requests in the inspector, and paying.",
  },
  {
    q: "Is the browser terminal end-to-end encrypted?",
    a: "Yes. The encryption runs in your browser, so the terminal traffic is encrypted between the browser and the machine. Our servers carry it and cannot read it.",
  },
  {
    q: "How many browser terminals can I open?",
    a: `${plans[0].browserTerminals} at once on Free, ${plans[1].browserTerminals} on Pro, no limit on Team. Terminals from the pb command are never limited.`,
  },
  {
    q: "Can I use it on a phone?",
    a: "It is a web app, so it opens in a phone's browser, but it is built and tested for desktop browsers. There is no native mobile app, and private access to ports needs pb installed, which a phone cannot do.",
  },
  {
    q: "How do I sign in?",
    a: "On the console's sign-in page, or through your company's single sign-on if your team requires it. Signing in from pb opens the same page and asks you to approve that computer.",
  },
]
---

<Feature
  slug="console"
  title="Web console | Paperboat"
  description="Your machines in a browser: end-to-end encrypted terminals, files, previews, access rules and billing, from any computer."
  headline="The web console"
  faq={faq}
  related={["terminal", "previews", "teams"]}
>
  <p slot="lede">
    The console is the companion to <code>pb</code>, for the moments a browser is the better tool: a borrowed computer, a list of forty
    machines, a webhook you want to watch arrive.
  </p>
  <Sheet slot="aside" steps={hero} table />

  <section class="section section-tint" aria-labelledby="pages-title">
    <div class="wrap">
      <header class="section-head">
        <h2 class="h2" id="pages-title">What the console shows</h2>
        <p class="lede">No screenshots here on purpose: the console changes every week, and this list stays true.</p>
      </header>
      <table class="facts">
        <tbody>
          {pages.map(([name, text]) => <tr><th scope="row">{name}</th><td>{text}</td></tr>)}
        </tbody>
      </table>
    </div>
  </section>
</Feature>
