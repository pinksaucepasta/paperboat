---
import { Image } from "astro:assets"
import Feature from "../../layouts/Feature.astro"
import Beat from "../../components/Beat.astro"
import Term from "../../components/Term.astro"
import machines from "../../assets/console/machines.png"
import terminals from "../../assets/console/terminals.png"
import previews from "../../assets/console/previews.png"
import { plans } from "../../site"

const faq = [
  {
    q: "Do I need the console to use Paperboat?",
    a: "No. Everything the console does, pb does too. Some things are just nicer in a browser: inviting people, reading the audit log, watching requests come in.",
  },
  {
    q: "Is the browser terminal end-to-end encrypted?",
    a: "Yes. The encryption runs in your browser, so terminal traffic is encrypted between the browser and the machine.",
  },
  {
    q: "How many browser terminals can I open?",
    a: `${plans[0].browserTerminals} at once on Free, ${plans[1].browserTerminals} on Pro, and no limit on Team. Terminals from the pb command have no limit on any plan.`,
  },
  {
    q: "How do I sign in?",
    a: "On the console's sign-in page, or with your company's single sign-on. Signing in from pb opens the same page and asks you to approve that computer.",
  },
]
---

<Feature
  slug="console"
  title="The Paperboat web console"
  description="Your machines in a browser tab: terminals, files, previews, tunnels, secrets, access rules and billing in one place."
  headline="All your machines in one tab"
  faq={faq}
  related={["terminal", "previews", "teams"]}
>
  <p slot="lede">Open a terminal, check a preview, approve a file or change who can reach what, from any browser.</p>
  <Term slot="aside" lines={["$ pb machine add --name build-02", "# prints a one-time install line", "# or press Add machine in the console"]} />

  <Beat id="machines-title" title="Every machine at a glance" wide>
    <p>See which machines are online, what each is running and how much traffic you've used this month.</p>
    <figure slot="visual" class="shot">
      <Image src={machines} alt="The Paperboat console: seven machines, six online, with their addresses, what each is running and this month's bandwidth." widths={[1376, 2752]} sizes="1200px" format="png" />
    </figure>
  </Beat>

  <Beat id="terminals-title" title="Terminals in the browser" wide>
    <p>The same shells you open with pb, end-to-end encrypted from your browser to the machine. Handy on a borrowed computer.</p>
    <figure slot="visual" class="shot">
      <Image src={terminals} alt="The console's Terminals page: four open terminals on studio, gpu-box and staging, one in use." widths={[1136, 2272]} sizes="1136px" format="png" />
    </figure>
  </Beat>

  <Beat id="previews-title" title="What's online right now" wide>
    <p>Every live preview and tunnel, who can open it, and when it stops. Watch requests arrive and replay them.</p>
    <figure slot="visual" class="shot">
      <Image src={previews} alt="The console's Previews page: three live previews on macbook, studio and staging, one visible only to its owner." widths={[1136, 2272]} sizes="1136px" format="png" />
    </figure>
  </Beat>

  <section class="section section-rule" aria-labelledby="details-title">
    <div class="wrap">
      <h2 class="visually-hidden" id="details-title">Details</h2>
      <div class="points points-3">
        <div>
          <h3 class="h3">Secrets in your browser</h3>
          <p>ENV values are entered and decrypted in your browser, never on our servers.</p>
        </div>
        <div>
          <h3 class="h3">Access as a grid</h3>
          <p>Edit rules as a grid or as the file, test them, and roll back to any version.</p>
        </div>
        <div>
          <h3 class="h3">Usage and billing</h3>
          <p>Bandwidth by path, your limits, your plan and invoices.</p>
        </div>
      </div>
    </div>
  </section>
</Feature>

<style>
  .shot {
    width: fit-content;
    max-width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgb(20 20 20 / 0.08),
      0 24px 48px -32px rgb(20 20 20 / 0.18);
  }

  .shot :global(img) {
    display: block;
    width: 1136px;
    max-width: 100%;
    height: auto;
  }
</style>
