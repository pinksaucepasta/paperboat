---
import Feature from "../../layouts/Feature.astro"
import Beat from "../../components/Beat.astro"
import Term from "../../components/Term.astro"

const faq = [
  {
    q: "How is this different from ssh host command?",
    a: "No keys, no open port, and no shell quoting: everything after <code>--</code> arrives exactly as you typed it. You also get a timeout, JSON output, and a clear answer when a command's outcome can't be confirmed.",
  },
  {
    q: "How do I use a pipe on the other machine?",
    a: "Run a shell there: <code>pb exec studio -- sh -c 'journalctl -u api | tail -n 50'</code>. Pipes on your side work as usual, and input is passed through.",
  },
  {
    q: "What if the network drops while a command runs?",
    a: "pb reconnects and waits for the result. If the outcome truly can't be confirmed, it says so instead of guessing, so your script can decide whether to run it again.",
  },
  {
    q: "Can a command run for a long time?",
    a: 'Yes, with <code>--timeout</code> as long as you need. For work you want to watch, use a <a href="/features/terminal/">terminal</a>.',
  },
  {
    q: "Who can run commands on a machine?",
    a: 'You, on your own machines. For anyone else, running commands is one permission you give per machine, separate from terminals or SSH. See <a href="/features/teams/">teams and access</a>.',
  },
]
---

<Feature
  slug="exec"
  title="Remote commands | Paperboat"
  description="Run a command on any of your machines and get its output and exit code back. Built for scripts, CI and agents."
  headline="Run a command on any machine"
  faq={faq}
  related={["terminal", "env", "ssh"]}
  compare={["ssh-bastion", "teleport"]}
>
  <p slot="lede">Name the machine and the command. You get its output and its exit code back, as if it ran here.</p>
  <Term slot="aside" lines={["$ pb exec studio -- systemctl is-active api", "active", "$ pb exec studio -- git -C /srv/api pull", "Already up to date."]} />

  <Beat id="scripts-title" title="Made for scripts and CI">
    <p>A failing command fails your script. Wait for a machine, run the tests there, ship the result, all from one file.</p>
    <Term
      slot="visual"
      title="deploy.sh"
      lines={["pb wait build-01", "pb exec build-01 -- make test", "pb send app.tar.gz --to web-01", "pb exec web-01 -- systemctl restart app"]}
    />
  </Beat>

  <Beat id="agents-title" title="Safe to hand to an agent" flip>
    <p>Give a coding agent a token that can run commands on the machines you pick, and nothing else.</p>
    <Term slot="visual" lines={["$ pb api-token create agent --expires 7d", "$ pb policy explain --api-token agent \\", "    --dst machine:db --action exec", "DENIED: no rule allows it"]} />
  </Beat>

  <section class="section section-rule" aria-labelledby="details-title">
    <div class="wrap">
      <h2 class="visually-hidden" id="details-title">Details</h2>
      <div class="points points-3">
        <div>
          <h3 class="h3">Exactly what you typed</h3>
          <p>No shell in between, so nothing is split or expanded twice.</p>
        </div>
        <div>
          <h3 class="h3">Your secrets are there</h3>
          <p>Your <a href="/features/env/">ENV</a> values are set before the command starts.</p>
        </div>
        <div>
          <h3 class="h3">JSON when you need it</h3>
          <p><code>--json</code> gives output, errors and the exit code as events a program can read.</p>
        </div>
      </div>
    </div>
  </section>
</Feature>
