---
import Feature from "../../layouts/Feature.astro"
import Beat from "../../components/Beat.astro"
import Term from "../../components/Term.astro"
import { selfhostInstallUrl } from "../../site"

const faq = [
  {
    q: "What do I need?",
    a: "A Linux server with a public IP address: Ubuntu 22.04 or 24.04, or Debian 12, on amd64 or arm64. The install line adds Docker if it is missing.",
  },
  {
    q: "Why run my own relay?",
    a: "To keep relayed traffic on a server and network you choose, to stop counting it against your plan, and to send files of any size. You can tell your machines to use only your relays.",
  },
  {
    q: "Why run my own tunnel server?",
    a: "Visitors to your previews and tunnels then connect to your server, on your domain, and their HTTPS ends on a box you run. Public TCP addresses have no limit there.",
  },
  {
    q: "How do I upgrade?",
    a: "Run the install line again. It upgrades in place and keeps its data.",
  },
  {
    q: "Which plans include it?",
    a: "Every plan, Free included.",
  },
]
---

<Feature
  slug="self-hosting"
  title="Run your own relay and tunnel server | Paperboat"
  description="Run Paperboat's relay and tunnel server on your own Linux box. Traffic through it never counts against your plan."
  headline="Your own relay and tunnel server"
  faq={faq}
  related={["tunnels", "previews", "files"]}
  compare={["tailscale", "ngrok", "netbird"]}
>
  <p slot="lede">Run the servers that carry your traffic on a Linux box of your own. Traffic through them never counts against your plan.</p>
  <Term slot="aside" title="your server" lines={["$ curl -fsSL \\", `    ${selfhostInstallUrl} \\`, "    | sh -s -- --both", "$ pbh selfhost code"]} />

  <Beat id="relay-title" title="Your relay">
    <p>When two of your machines can't connect directly, they meet at your server instead of ours. It still sees only encrypted traffic.</p>
    <Term slot="visual" lines={["$ pb relay list", "home-relay   yours    12 ms", "eu-central   hosted   31 ms"]} />
  </Beat>

  <Beat id="edge-title" title="Your tunnel server" flip>
    <p>Visitors to your previews and tunnels connect to your server, on your domain. Their HTTPS ends on a box you run.</p>
    <Term slot="visual" lines={["$ pb tunnel create api --port 8080", `✓ https://api.dev.acme.com`, "# served by edge-1.acme.com"]} />
  </Beat>

  <section class="section section-rule" aria-labelledby="details-title">
    <div class="wrap">
      <h2 class="visually-hidden" id="details-title">Details</h2>
      <div class="points points-3">
        <div>
          <h3 class="h3">Five minutes to set up</h3>
          <p>One install line, then paste a code into the console.</p>
        </div>
        <div>
          <h3 class="h3">Not counted</h3>
          <p>Bandwidth through your own servers is free on every plan.</p>
        </div>
        <div>
          <h3 class="h3">Any file size</h3>
          <p>Unlimited file sends go through your relay when a direct path isn't there.</p>
        </div>
      </div>
    </div>
  </section>
</Feature>
