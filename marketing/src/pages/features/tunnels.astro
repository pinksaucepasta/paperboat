---
import Feature from "../../layouts/Feature.astro"
import Beat from "../../components/Beat.astro"
import Term from "../../components/Term.astro"
import { tunnelDomain, publicTcp } from "../../site"

const faq = [
  {
    q: "Are custom domains a paid feature?",
    a: "No. Your own domains, with certificates issued and renewed for you, are on every plan including Free.",
  },
  {
    q: "Does the address ever change?",
    a: `No. A tunnel's address under ${tunnelDomain} is made when you create it and stays with that tunnel until you delete it.`,
  },
  {
    q: "Can I put a database or another TCP service online?",
    a: `Yes, with a tcp route, which gets its own public port. Free includes ${publicTcp[0]} public TCP address, Pro ${publicTcp[1]} and Team ${publicTcp[2]}. On a tunnel server you host, there is no limit. If only your machines need it, use a private route.`,
  },
  {
    q: "Can I limit who reaches a tunnel?",
    a: "Yes. A tunnel created with <code>--private</code> or <code>--team</code> answers only you or your teammates, from their own signed-in machines.",
  },
  {
    q: "Where does HTTPS end?",
    a: "At the tunnel server, which then sends the request to your machine over an encrypted connection. With a <code>tls</code> route your app keeps its own certificate and the bytes pass through unread. You can also run the tunnel server yourself.",
  },
]
---

<Feature
  slug="tunnels"
  title="Permanent tunnels and custom domains | Paperboat"
  description="A permanent public address for a service on your machine, on our domain or yours, that comes back after a reboot."
  headline="A permanent address for your service"
  faq={faq}
  related={["previews", "self-hosting", "teams"]}
  compare={["cloudflare-tunnel", "ngrok"]}
>
  <p slot="lede">Give a service on your machine a public address that stays. It comes back by itself after a reboot, on our domain or your own.</p>
  <Term slot="aside" lines={["$ pb tunnel create api --port 8080", "✓ Created tunnel api", `https://calm-summer-beach-3476.${tunnelDomain}`]} />

  <Beat id="domain-title" title="On your own domain">
    <p>Add your domain once and every tunnel can use it. Certificates are issued and renewed for you, on every plan.</p>
    <Term slot="visual" lines={["$ pb domain add dev.acme.com", "$ pb domain verify dev.acme.com", "$ pb tunnel domain add api \\", "    api.dev.acme.com --route web"]} />
  </Beat>

  <Beat id="routes-title" title="Many apps, one tunnel" flip>
    <p>Send each path or name to a different app. Put a database online on a TCP port, or keep a route private to your machines.</p>
    <Term slot="visual" lines={["$ pb tunnel route add api --name web \\", "    --to http://localhost:3000 --path /", "$ pb tunnel route add api --name db \\", "    --to localhost:5432 --protocol tcp"]} />
  </Beat>

  <Beat id="status-title" title="Tells you what's wrong">
    <p>When your app stops answering, the tunnel says why, and what to run to fix it.</p>
    <Term slot="visual" lines={["$ pb tunnel status api", "origin_refused: nothing is listening", "on the app's port.", "Start the app on the route's port."]} />
  </Beat>

  <section class="section section-rule" aria-labelledby="details-title">
    <div class="wrap">
      <h2 class="visually-hidden" id="details-title">Details</h2>
      <div class="points points-3">
        <div>
          <h3 class="h3">Every protocol you need</h3>
          <p>HTTP/1.1, HTTP/2, HTTP/3, WebSocket, raw TCP and TLS pass-through.</p>
        </div>
        <div>
          <h3 class="h3">Pause without deleting</h3>
          <p>Take a tunnel offline for a while and bring it back on the same address.</p>
        </div>
        <div>
          <h3 class="h3">Your own tunnel server</h3>
          <p><a href="/features/self-hosting/">Run the edge yourself</a> and the traffic never touches ours.</p>
        </div>
      </div>
    </div>
  </section>
</Feature>
