---
import Feature from "../../layouts/Feature.astro"
import Beat from "../../components/Beat.astro"
import Term from "../../components/Term.astro"

const faq = [
  {
    q: "Can Paperboat read my secrets?",
    a: "No. Values are encrypted on your device, and our servers only hold the encrypted form. The keys are protected by a master password that never leaves your device.",
  },
  {
    q: "What if I forget the master password?",
    a: "Use the recovery code you saved when you set up ENV. Because only you hold the keys, keep that code somewhere safe.",
  },
  {
    q: "Where does it work?",
    a: "In Paperboat terminals and <code>pb exec</code> by itself. In scripts and CI with <code>pb env run -- &lt;command&gt;</code>. In plain ssh, your own shell and VS Code terminals after <code>pb env hook --install</code>.",
  },
  {
    q: "How is this different from a .env file?",
    a: "A .env file has to be copied to every machine and tends to end up in a repository. With ENV, values appear in your commands' environment on every machine and are changed in one place.",
  },
  {
    q: "What happens when I remove a machine?",
    a: "It stops getting values. pb then offers to rotate the keys, so the machine can't read anything new.",
  },
]
---

<Feature
  slug="env"
  title="Encrypted environment variables | Paperboat"
  description="Set a secret once and use it on every machine. Encrypted on your device, so Paperboat's servers can never read it."
  headline="Your secrets on every machine"
  faq={faq}
  related={["recipes", "exec", "config-sync"]}
  compare={["tailscale", "teleport"]}
>
  <p slot="lede">Set a secret once and it's there on every machine you use. It's encrypted on your device, so only your machines can read it.</p>
  <Term slot="aside" lines={["$ pb env set STRIPE_KEY", "# the value is typed in a hidden prompt", "$ pb env run -- npm test", "✓ 42 tests passed"]} />

  <Beat id="where-title" title="Set it once, use it everywhere">
    <p>Change a value on your laptop and every machine has it for the next command. No .env files to copy around.</p>
    <Term slot="visual" title="studio" lines={["ana@studio:~$ echo $STRIPE_KEY | cut -c1-8", "sk_live_"]} />
  </Beat>

  <Beat id="scope-title" title="Per machine, per team" flip>
    <p>Give one machine its own value, or share a set with your team. Your personal values stay yours.</p>
    <Term slot="visual" lines={["$ pb env set DATABASE_URL --machine staging", "$ pb env set SENTRY_DSN --team acme"]} />
  </Beat>

  <Beat id="vault-title" title="Vaults for machines">
    <p>Group the values a kind of machine needs into a vault. A <a href="/features/recipes/">recipe</a> gives it to every new sandbox, with nobody online.</p>
    <Term slot="visual" lines={["$ pb env vault create sandbox-env", "$ pb env set API_KEY --vault sandbox-env"]} />
  </Beat>

  <section class="section section-rule" aria-labelledby="details-title">
    <div class="wrap">
      <h2 class="visually-hidden" id="details-title">Details</h2>
      <div class="points points-3">
        <div>
          <h3 class="h3">Encrypted on your device</h3>
          <p>Our servers store and pass along only the encrypted form.</p>
        </div>
        <div>
          <h3 class="h3">Never printed</h3>
          <p>pb lists names, never values, so secrets stay out of logs and screens.</p>
        </div>
        <div>
          <h3 class="h3">Kept in your keychain</h3>
          <p>Keychain on macOS, Secret Service on Linux, the credential store on Windows.</p>
        </div>
      </div>
    </div>
  </section>
</Feature>
