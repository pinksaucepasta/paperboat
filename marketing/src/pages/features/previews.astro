---
import { Image } from "astro:assets"
import Feature from "../../layouts/Feature.astro"
import Beat from "../../components/Beat.astro"
import Term from "../../components/Term.astro"
import previews from "../../assets/console/previews.png"
import { previewDomain } from "../../site"

const faq = [
  {
    q: "What does the address look like?",
    a: `Three words and four digits under ${previewDomain}, made for you and never given to anyone else. It stays the same while the preview runs. For a name of your own, add <code>--domain demo.example.com</code> on a domain you added.`,
  },
  {
    q: "How long does a preview last?",
    a: "Until you press Ctrl+C, or for the time you give with <code>--ttl 2h</code>. In the background it lasts up to 24 hours. For an address that stays, turn it into a <a href=\"/features/tunnels/\">tunnel</a>: press <kbd>t</kbd> while it runs.",
  },
  {
    q: "Do WebSockets and HTTP/3 work?",
    a: "Yes. Previews carry HTTP/1.1, HTTP/2, HTTP/3 and WebSocket, including large uploads and downloads.",
  },
  {
    q: "My dev server refuses the public name. What now?",
    a: 'Vite, Next.js, Django and most proxies check the host name. <a href="/docs/put-any-server-behind-paperboat/">Put any server behind Paperboat</a> has the one setting each needs.',
  },
  {
    q: "How many previews can I run?",
    a: "10 previews and tunnels at once on Free, 100 on Pro, and no limit on Team.",
  },
  {
    q: "Where are inspected requests kept?",
    a: "On your own machine. The console reads them from there over an encrypted connection.",
  },
]
---

<Feature
  slug="previews"
  title="Share localhost over HTTPS | Paperboat"
  description="Give localhost a public HTTPS link in one command, with an inspector to see and replay every request."
  headline="Put localhost on a public link"
  faq={faq}
  related={["tunnels", "private-access", "self-hosting"]}
  compare={["ngrok", "cloudflare-tunnel", "vscode-tunnels"]}
>
  <p slot="lede">One command gives the app on your machine a public HTTPS address. Send the link, get feedback, press Ctrl+C when you're done.</p>
  <Term
    slot="aside"
    lines={["$ pb preview 3000", "Preview ready", `https://quiet-river-lantern-4821.${previewDomain}`, "", "Press Ctrl+C to stop"]}
  />

  <Beat id="see-title" title="See every request" wide>
    <p>Every request that reaches your app is kept on your machine. Look inside one, or send it again while you fix the bug.</p>
    <figure slot="visual" class="shot">
      <Image src={previews} alt="The console's Previews page: three live previews on macbook, studio and staging, one visible only to its owner." widths={[1136, 2272]} sizes="1136px" format="png" />
    </figure>
  </Beat>

  <Beat id="who-title" title="Public, private or team">
    <p>Share with anyone who has the link, or only with yourself or your team, signed in on their own machines.</p>
    <Term slot="visual" lines={["$ pb preview 3000", "# anyone with the link", "$ pb preview 3000 --private", "# only you", "$ pb preview 3000 --team", "# you and your teammates"]} />
  </Beat>

  <Beat id="what-title" title="A port, a folder or a socket" flip>
    <p>Share a running app, a folder of static files from a build, or a Unix socket.</p>
    <Term slot="visual" lines={["$ pb preview 8080", "$ pb preview ./dist", "$ pb preview unix:///tmp/app.sock"]} />
  </Beat>

  <section class="section section-rule" aria-labelledby="details-title">
    <div class="wrap">
      <h2 class="visually-hidden" id="details-title">Details</h2>
      <div class="points points-3">
        <div>
          <h3 class="h3">Live at once</h3>
          <p>The link works at once, even before your app has started.</p>
        </div>
        <div>
          <h3 class="h3">Stops on its own</h3>
          <p><code>--ttl 2h</code> ends the preview after two hours, so nothing stays open by mistake.</p>
        </div>
        <div>
          <h3 class="h3">Becomes a tunnel</h3>
          <p>Press <kbd>t</kbd> and the preview becomes a <a href="/features/tunnels/">permanent address</a>.</p>
        </div>
      </div>
    </div>
  </section>
</Feature>

<style>
  .shot {
    border-radius: 12px;
    overflow: hidden;
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgb(20 20 20 / 0.08),
      0 24px 48px -32px rgb(20 20 20 / 0.18);
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
