---
import Page from "../../layouts/Page.astro"
import PageHead from "../../components/PageHead.astro"
import Section from "../../components/Section.astro"
import CompareTable from "../../components/CompareTable.astro"
import CommandExample from "../../components/CommandExample.astro"
import Closing from "../../components/Closing.astro"
import { paperboat, products } from "../../compare-data"

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }))
}
const { product } = Astro.props
const title = `Paperboat vs ${product.name}`
---

<Page title={`${title} — Paperboat`} description={product.summary}>
  <PageHead title={title}>
    <p>{product.summary}</p>
    <p class="back"><a href={`/compare?vs=${product.slug}`}>Compare with other tools</a></p>
  </PageHead>

  <Section id="differences" title="Key differences">
    <div class="differences">
      {
        product.differences.map((difference) => (
          <article class="difference">
            <div class="difference-text">
              <h3 class="subtitle">{difference.title}</h3>
              {difference.body.map((paragraph) => (
                <p class="body">{paragraph}</p>
              ))}
            </div>
            {(difference.them || difference.us) && (
              <div class="difference-code">
                {difference.them && (
                  <figure>
                    <figcaption>{product.label}</figcaption>
                    <CommandExample text={difference.them} />
                  </figure>
                )}
                {difference.us && (
                  <figure>
                    <figcaption>Paperboat</figcaption>
                    <CommandExample text={difference.us} />
                  </figure>
                )}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </Section>

  <Section id="table" title="Feature by feature" tone="surface">
    <CompareTable products={[product]} picked={[product.slug]} />
  </Section>

  <Section id="choose" title="Which to choose">
    <div class="pair">
      <div>
        <h3 class="subtitle">Choose {product.label} when</h3>
        <ul class="points">{product.chooseThem.map((point) => <li class="body">{point}</li>)}</ul>
      </div>
      <div>
        <h3 class="subtitle">Choose Paperboat when</h3>
        <ul class="points">{product.chooseUs.map((point) => <li class="body">{point}</li>)}</ul>
      </div>
    </div>
  </Section>

  <Section id="pricing" title="Pricing" tone="surface">
    <div class="pair">
      <div>
        <h3 class="subtitle">{product.label}</h3>
        <ul class="points">{product.pricing.lines.map((line) => <li class="body">{line}</li>)}</ul>
        <p class="source">
          <a href={product.pricing.source} rel="noopener">Source: {product.pricing.source.replace(/^https:\/\//, "")}</a>
        </p>
      </div>
      <div>
        <h3 class="subtitle">Paperboat</h3>
        <ul class="points">{paperboat.pricing.map((line) => <li class="body">{line}</li>)}</ul>
        <p class="source"><a href="/pricing">Pricing</a></p>
      </div>
    </div>
  </Section>

  <Section id="switching" title={`Switching from ${product.name}`}>
    <ol class="steps">{product.switching.map((step) => <li class="body">{step}</li>)}</ol>
  </Section>

  <Section id="faq" title="Questions" tone="surface">
    <dl class="faq">
      {
        product.faq.map((item) => (
          <div>
            <dt class="subtitle">{item.q}</dt>
            <dd class="body">{item.a}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Closing />
</Page>

<style>
  .back {
    margin-top: 8px;
  }

  .back a {
    color: var(--link);
  }

  .differences {
    display: grid;
    gap: clamp(48px, 6vw, 72px);
  }

  .difference {
    display: grid;
    gap: 24px;
    align-items: start;
  }

  .difference-text {
    display: grid;
    gap: 12px;
    max-width: 560px;
  }

  .difference-code {
    display: grid;
    gap: 16px;
    min-width: 0;
  }

  figure {
    display: grid;
    gap: 8px;
    margin: 0;
    min-width: 0;
  }

  figcaption {
    font-size: 0.8125rem;
    color: var(--fog);
  }

  .pair {
    display: grid;
    gap: 40px;
  }

  .pair > div {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .points {
    display: grid;
    gap: 10px;
    margin: 0;
    padding-left: 1.1em;
  }

  .source {
    margin: 0;
    font-size: 0.8125rem;
  }

  .source a {
    color: var(--fog);
    word-break: break-all;
  }

  .steps {
    display: grid;
    gap: 12px;
    max-width: 640px;
    margin: 0;
    padding-left: 1.25rem;
  }

  .faq {
    display: grid;
    gap: 32px;
    max-width: 720px;
    margin: 0;
  }

  .faq div {
    display: grid;
    gap: 8px;
  }

  .faq dd {
    margin: 0;
  }

  @media (min-width: 960px) {
    .difference {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 48px;
    }

    .pair {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
