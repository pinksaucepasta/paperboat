---
import Page from "../../layouts/Page.astro"
import Head from "../../components/Head.astro"
import CompareTable from "../../components/CompareTable.astro"
import Closing from "../../components/Closing.astro"
import { checked, defaultPicks, products } from "../../compare-data"
import { breadcrumbSchema } from "../../schema"

---

<Page
  title="Paperboat vs Tailscale, ngrok, Cloudflare Tunnel and more"
  description="See what changes when you move to Paperboat from Tailscale, ngrok, Cloudflare Tunnel, Teleport and more."
  schema={[breadcrumbSchema(Astro.site, [["Compare", "/compare/"]])]}
>
  <Head title="Coming from another tool?">
    <p>Most people arrive with a VPN, a tunnel tool or a bastion host. Here's what you keep, what you gain, and how to move over.</p>
  </Head>

  <section class="section list-section" aria-labelledby="pages-title">
    <div class="wrap">
      <h2 class="visually-hidden" id="pages-title">Comparisons</h2>
      <ul class="pages">
        {
          products.map((product) => (
            <li>
              <a href={`/compare/${product.slug}/`}>
                <span class="page-name">Paperboat vs {product.label}</span>
                <span class="page-line">{product.tagline}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-tint compare-tint" aria-labelledby="table-title">
    <div class="wrap">
      <header class="section-head">
        <h2 class="h2" id="table-title">Side by side</h2>
        <p class="lede">Pick up to two tools to see beside Paperboat. Every answer about them links to its source, checked {checked}.</p>
      </header>
      <CompareTable products={products} picked={defaultPicks} picker />
    </div>
  </section>

  <Closing />
</Page>

<style>
  .list-section {
    padding-top: 0;
  }

  .pages {
    display: grid;
    gap: 0 var(--s7);
    border-top: 1px solid var(--rule);
  }

  .pages a {
    display: grid;
    gap: 2px;
    padding-block: var(--s4);
    border-bottom: 1px solid var(--rule);
  }

  .page-name {
    font-weight: 500;
    color: var(--ink);
  }

  .pages a:hover .page-name {
    color: var(--cobalt);
  }

  .page-line {
    color: var(--fog);
    font-size: var(--text-ui);
    line-height: 1.5;
  }

  @media (min-width: 860px) {
    .pages {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
