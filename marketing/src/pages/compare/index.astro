---
import Page from "../../layouts/Page.astro"
import PageHead from "../../components/PageHead.astro"
import Section from "../../components/Section.astro"
import CompareTable from "../../components/CompareTable.astro"
import Closing from "../../components/Closing.astro"
import { defaultPicks, products } from "../../compare-data"
---

<Page
  title="Compare — Paperboat"
  description="Paperboat next to Tailscale, ngrok, Cloudflare, Teleport, NetBird, ZeroTier, Twingate, enterprise VPNs, SSH and VS Code Remote Tunnels."
>
  <PageHead title="Compare">
    <p>
      Pick up to two tools and compare them with Paperboat. Every claim about another product links to its documentation.
    </p>
  </PageHead>

  <Section id="table">
    <CompareTable products={products} picked={defaultPicks} picker />
  </Section>

  <Section id="pages" title="Paperboat vs one tool" tone="surface">
    <Fragment slot="text">
      <p>Differences, pricing, which to choose and how to switch.</p>
    </Fragment>
    <ul class="pages">
      {
        products.map((product) => (
          <li>
            <a href={`/compare/${product.slug}`}>
              <span class="page-name">Paperboat vs {product.label}</span>
              <span class="page-line">{product.summary.split(". ")[0]}.</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Closing />
</Page>

<style>
  .pages {
    display: grid;
    gap: 0 48px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pages a {
    display: grid;
    gap: 4px;
    padding-block: 18px;
    border-top: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
  }

  .page-name {
    font-family: var(--font-brand);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--ink);
  }

  .pages a:hover .page-name {
    color: var(--cobalt);
  }

  .page-line {
    color: var(--fog);
    font-size: 0.9375rem;
    max-width: 52ch;
  }

  @media (min-width: 860px) {
    .pages {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
