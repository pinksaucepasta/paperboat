---
import Page from "../layouts/Page.astro"
import PageHead from "../components/PageHead.astro"
import Section from "../components/Section.astro"
import { securitySections } from "../security-data"
---

<Page title="Security — Paperboat" description="What Paperboat encrypts end to end, what our servers can see, and where your data lives.">
  <PageHead title="Security">
    <p>What we can see, what we can’t, and where your data lives.</p>
  </PageHead>
  {
    securitySections.map((section, index) => (
      <Section id={section.id} title={section.title} tone={index % 2 === 0 ? "plain" : "surface"}>
        <Fragment slot="text">
          <p>{section.text}</p>
        </Fragment>
      </Section>
    ))
  }
</Page>
