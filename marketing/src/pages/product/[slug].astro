---
import Page from "../../layouts/Page.astro"
import PageHead from "../../components/PageHead.astro"
import Section from "../../components/Section.astro"
import CommandExample from "../../components/CommandExample.astro"
import Closing from "../../components/Closing.astro"
import { products } from "../../product-data"
import { compares } from "../../compare-data"

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }))
}
const { product } = Astro.props
const related = compares.filter((compare) => product.compare.includes(compare.slug))
---

<Page title={`${product.name} — Paperboat`} description={product.summary}>
  <PageHead title={product.headline} eyebrow={product.name}>
    <p>{product.summary}</p>
  </PageHead>

  <Section id="benefits" title="What it does">
    <div class="benefits">
      {
        product.benefits.map((benefit) => (
          <div class="benefit">
            <h3 class="subtitle">{benefit.title}</h3>
            <p class="body">{benefit.text}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section id="example" title={product.example.title} tone="surface">
    <CommandExample text={product.example.text} />
  </Section>

  <Section id="how" title="How it works">
    <ol class="steps">
      {
        product.steps.map((step) => (
          <li class="step">
            <h3 class="subtitle">{step.title}</h3>
            <p class="body">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="more" title="Works with" tone="surface">
    <ul class="more">
      {
        product.related.map((item) => (
          <li>
            <a class="text-link" href={`/product/${item.slug}`}>
              {products.find((other) => other.slug === item.slug)!.name} <span class="arrow">→</span>
            </a>
            <p class="body">{item.text}</p>
          </li>
        ))
      }
    </ul>
    {
      related.length > 0 && (
        <p class="body compared">
          Compared with:{" "}
          {related.map((compare, index) => (
            <>
              {index > 0 && ", "}
              <a class="text-link" href={`/compare/${compare.slug}`}>{compare.name}</a>
            </>
          ))}
        </p>
      )
    }
  </Section>

  <Closing />
</Page>

<style>
  .benefits,
  .steps {
    display: grid;
    gap: 32px;
  }

  .benefit,
  .step {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .steps {
    counter-reset: step;
  }

  .step {
    counter-increment: step;
  }

  .step .subtitle::before {
    content: counter(step) ". ";
    color: var(--cobalt);
  }

  .more {
    display: grid;
    gap: 24px;
  }

  .more li {
    display: grid;
    gap: 4px;
  }

  .compared {
    margin-top: 32px;
  }

  @media (min-width: 860px) {
    .benefits,
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }
</style>
