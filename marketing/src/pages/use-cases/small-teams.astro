---
import UseCase from "../../layouts/UseCase.astro"
import Beat from "../../components/Beat.astro"
import Term from "../../components/Term.astro"
import { plans, ssoMinSeats } from "../../site"

const faq = [
  {
    q: "Do we need the Team plan to work together?",
    a: `Sharing a live terminal or a preview link works on every plan. Team, at ${plans[2].price} a seat a month, adds lasting access to each other's machines, roles and an exportable audit log. Single sign-on starts at ${ssoMinSeats} seats.`,
  },
  {
    q: "Who owns a machine a member brings?",
    a: "They do, until they transfer it. Sharing a personal machine with the team lends it; a machine added to the team belongs to the team.",
  },
  {
    q: "How is bandwidth counted for a team?",
    a: "Each seat brings 100 GB a month at full speed through our edges and relays. After that, traffic is slowed, never stopped. Direct traffic between machines is never counted.",
  },
  {
    q: "Is there a contract or a minimum?",
    a: "No. One seat is the minimum, billed monthly or yearly by card, and you can cancel in the console.",
  },
]
---

<UseCase
  slug="small-teams"
  name="Small teams"
  title="Shared machines for small teams | Paperboat"
  description="Give teammates exactly the access they need, as rules anyone can read. Every session is logged."
  headline="Shared machines for small teams"
  faq={faq}
  related={["teams", "env", "previews", "recordings"]}
  compare={["teleport", "tailscale", "twingate"]}
>
  <p slot="lede">Stop passing keys around. Give each person what they need on each machine, and take it back in one step.</p>
  <Term slot="aside" lines={["$ pb team invite acme maya@acme.com \\", "    --generation 7", "# Maya installs Paperboat and signs in", "maya@laptop:~$ pb ssh staging"]} />

  <Beat id="review-title" title="Review links for the team">
    <p>Put a branch on a link only your teammates can open. Nobody else gets in.</p>
    <Term slot="visual" lines={["$ pb preview 3000 --team", "Preview ready", "# only acme members can open it"]} />
  </Beat>

  <Beat id="secrets-title" title="One place for team secrets" flip>
    <p>The API key lives in the team's ENV. Deploy scripts get it, and nobody pastes it into chat.</p>
    <Term slot="visual" lines={["$ pb env set STRIPE_KEY --team acme", "$ pb env run -- ./deploy.sh"]} />
  </Beat>

  <Beat id="night-title" title="Fix it together at 2 a.m.">
    <p>Share your terminal. A colleague watches, then types, in the same shell. Record it for the write-up.</p>
    <Term slot="visual" lines={["$ pb session share S12 --team acme --all", "$ pb recordings start"]} />
  </Beat>

  <Beat id="leave-title" title="Someone leaves, access ends" flip>
    <p>Remove them and their sessions end at once, their tokens stop working, and the audit log shows what they did last.</p>
    <Term slot="visual" lines={["$ pb team remove acme maya@acme.com \\", "    --generation 8", "# their sessions end at once"]} />
  </Beat>
</UseCase>
