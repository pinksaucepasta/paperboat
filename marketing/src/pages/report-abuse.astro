---
import Page from "../layouts/Page.astro"
import Head from "../components/Head.astro"
import { abuseMailbox, apiBaseUrl } from "../site"
import { breadcrumbSchema } from "../schema"

// Closed list: the same reasons the server accepts (POST /v1/abuse-reports).
const reasons = [
  ["phishing", "Phishing or a fake sign-in page"],
  ["malware", "Malware or a harmful download"],
  ["spam", "Spam"],
  ["illegal", "Illegal content"],
  ["other", "Something else"],
]
---

<Page
  title="Report abuse | Paperboat"
  description="Report phishing, malware, spam or illegal content on a Paperboat link. No account needed."
  schema={[breadcrumbSchema(Astro.site, [["Report abuse", "/report-abuse/"]])]}
>
  <Head title="Report abuse">
    <p>
      Paperboat serves public preview and tunnel links. If one is used for phishing, malware, spam or anything illegal, tell us. You do not need
      an account.
    </p>
  </Head>

  <section class="section">
    <div class="wrap report">
      <form id="report" data-api={apiBaseUrl} novalidate>
        <label>
          <span class="label">Link</span>
          <input name="url" type="url" required maxlength="2048" placeholder="https://" autocomplete="off" />
          <span class="hint">The address of the page you are reporting, starting with http:// or https://.</span>
        </label>
        <label>
          <span class="label">What is wrong with it</span>
          <select name="reason" required>
            {reasons.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>
        <label>
          <span class="label">Details <span class="optional">(optional)</span></span>
          <textarea name="details" rows="5" maxlength="4000"></textarea>
          <span class="hint">What you saw and what it asks people to do. Do not include passwords or personal data.</span>
        </label>
        <p class="status" id="status" role="status" aria-live="polite" hidden></p>
        <div><button class="button button-primary" type="submit">Send report</button></div>
      </form>
      <aside class="prose">
        <p>We keep a report for 180 days and do not store your network address.</p>
        {
          abuseMailbox && (
            <p>
              Prefer email? Write to <a href={`mailto:${abuseMailbox}`}>{abuseMailbox}</a>.
            </p>
          )
        }
        <noscript><p>The form needs JavaScript. Please email the report instead.</p></noscript>
      </aside>
    </div>
  </section>
</Page>

<script>
  const form = document.querySelector<HTMLFormElement>("#report")!
  const status = document.querySelector<HTMLElement>("#status")!
  const send = form.querySelector<HTMLButtonElement>("button")!
  const mailbox = document.querySelector<HTMLAnchorElement>('aside a[href^="mailto:"]')?.textContent
  const email = mailbox ? ` Or email it to ${mailbox}.` : ""

  const show = (message: string, state: "ok" | "error") => {
    status.textContent = message
    status.dataset.state = state
    status.hidden = false
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault()
    const data = new FormData(form)
    const url = String(data.get("url") ?? "").trim()
    if (!/^https?:\/\/\S+$/i.test(url)) return show("Enter the full address of the link, starting with http:// or https://.", "error")
    send.disabled = true
    show("Sending…", "ok")
    try {
      const response = await fetch(new URL("/v1/abuse-reports", form.dataset.api), {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ url, reason: data.get("reason"), details: String(data.get("details") ?? "").trim() || undefined }),
        signal: AbortSignal.timeout(20_000),
      })
      const body = await response.json().catch(() => ({}))
      if (response.status === 202) {
        form.reset()
        return show(`Thank you. Your report is recorded (reference ${body?.data?.id ?? "n/a"}). We review every report.`, "ok")
      }
      if (response.status === 429) {
        const wait = Number(response.headers.get("retry-after"))
        return show(
          `Too many reports from your network. Try again ${wait > 0 ? `in ${wait} second${wait === 1 ? "" : "s"}` : "in a minute"}.${email}`,
          "error",
        )
      }
      if (response.status === 400) return show(`${body?.error?.message ?? "The report was not accepted."} Check the form and send it again.`, "error")
      show(`The report could not be recorded. Try again.${email}`, "error")
    } catch {
      show(`The report could not be sent. Check your connection and try again.${email}`, "error")
    } finally {
      send.disabled = false
    }
  })
</script>

<style>
  .report {
    display: grid;
    gap: var(--s7);
    align-items: start;
  }

  form {
    display: grid;
    gap: var(--s5);
    max-width: 40rem;
  }

  label {
    display: grid;
    gap: var(--s2);
  }

  .label {
    font-weight: 500;
    color: var(--ink);
  }

  .optional,
  .hint {
    font-size: var(--text-small);
    font-weight: 400;
    color: var(--fog);
  }

  input,
  select,
  textarea {
    font: inherit;
    font-size: var(--text-body);
    color: var(--ink);
    background: var(--paper);
    padding: var(--s3);
    border: 0;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px var(--rule);
    width: 100%;
  }

  textarea {
    resize: vertical;
  }

  .status {
    padding: var(--s3) var(--s4);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: var(--text-ui);
  }

  .status[data-state="error"] {
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .button:disabled {
    opacity: 0.6;
    cursor: default;
  }

  @media (min-width: 900px) {
    .report {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      column-gap: var(--s8);
    }
  }
</style>
