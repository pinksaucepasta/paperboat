---
import Page from "../layouts/Page.astro"
import Head from "../components/Head.astro"
import Faq from "../components/Faq.astro"
import Closing from "../components/Closing.astro"
import Icon from "../components/Icon.astro"
import Plans from "../components/Plans.astro"
import { plans, speeds, teamTrial, topUp } from "../site"
import { faq, featureGroups, planNames } from "../pricing-data"
import { breadcrumbSchema, faqSchema } from "../schema"

const speedRows = [
  ["Our edges (previews, tunnels)", `${plans[0].bandwidth}, then ${speeds.after[0]}`, `${plans[1].bandwidth}, then ${speeds.after[1]}`],
  ["Our relays", `${speeds.relay} for ${plans[0].bandwidth}, then ${speeds.after[0]}`, `${speeds.relay} for ${plans[1].bandwidth}, then ${speeds.after[1]}`],
  ["Browser terminals", "Never slowed", "Never slowed"],
  ["Your own edges and relays", "Unlimited", "Unlimited"],
  ["Direct traffic between your machines", "Unlimited", "Unlimited"],
]
---

<Page
  title="Plans and pricing | Paperboat"
  description="Every feature is free for personal use. Pro is $8 a month; Team is $15 a seat with roles, audit log and SSO."
  schema={[breadcrumbSchema(Astro.site, [["Pricing", "/pricing/"]]), faqSchema(faq)]}
>
  <Head title="Free for personal use" eyebrow="Pricing">
    <p>Every feature is on every plan, and nothing is ever cut off. Pro adds more full-speed traffic, and Team adds people.</p>
  </Head>

  <section class="section plans-section" aria-label="Plans">
    <div class="wrap">
      <Plans />
      <p class="small trial">{teamTrial}</p>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="bandwidth-title">
    <div class="wrap">
      <header class="section-head">
        <h2 class="h2" id="bandwidth-title">Never cut off</h2>
        <p class="lede">
          Traffic through our servers never stops. After your plan's full-speed amount it's slowed until the month resets. Through
          <a href="/features/self-hosting/">your own relays and edges</a>, it's never counted.
        </p>
      </header>
      <div class="scroll">
        <table class="facts speeds">
          <thead><tr><th scope="col"><span class="visually-hidden">Traffic</span></th><th scope="col">Free</th><th scope="col">Pro and Team</th></tr></thead>
          <tbody>
            {speedRows.map(([what, free, paid]) => <tr><th scope="row">{what}</th><td>{free}</td><td>{paid}</td></tr>)}
          </tbody>
        </table>
      </div>
      <div class="cols cols-3 rules">
        <div class="stack">
          <h3 class="h3">Need more speed?</h3>
          <p class="rule-text">On Pro and Team, add {topUp.size} at full speed for {topUp.price}, as often as you like.</p>
        </div>
        <div class="stack">
          <h3 class="h3">On a team</h3>
          <p class="rule-text">Every seat brings {plans[1].bandwidth} at full speed. Extra traffic you add is shared by the whole team.</p>
        </div>
        <div class="stack">
          <h3 class="h3">Always told</h3>
          <p class="rule-text"><code>pb</code> and the console show how much full-speed traffic is left, and where to add more.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="table-title">
    <div class="wrap">
      <header class="section-head">
        <h2 class="h2" id="table-title">Every feature by plan</h2>
        <p class="lede">
          Not sure which tool you need at all? <a href="/compare/">Compare Paperboat</a> with Tailscale, ngrok, Cloudflare Tunnel and others.
        </p>
      </header>
      <div class="scroll" tabindex="0" role="region" aria-labelledby="table-title">
        <table class="facts table">
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Feature</span></th>
              {planNames.map((name) => <th scope="col">{name}</th>)}
            </tr>
          </thead>
          {
            featureGroups.map((group) => (
              <tbody>
                <tr class="group">
                  <th scope="colgroup" colspan="4">
                    {group.title}
                  </th>
                </tr>
                {group.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.feature}</th>
                    {row.cells.map((cell) => (
                      <td>
                        {cell === true ? (
                          <>
                            <Icon name="check" size={18} class="yes" />
                            <span class="visually-hidden">Included</span>
                          </>
                        ) : cell === false ? (
                          <>
                            <span class="no" aria-hidden="true">–</span>
                            <span class="visually-hidden">Not included</span>
                          </>
                        ) : (
                          cell
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            ))
          }
        </table>
      </div>
    </div>
  </section>

  <Faq items={faq} title="Pricing questions" />
  <Closing />
</Page>

<style>
  .speeds {
    min-width: 560px;
  }

  .speeds tbody th {
    width: 40%;
  }

  .plans-section {
    padding-top: 0;
  }

  .trial {
    margin-top: var(--s5);
    max-width: 70ch;
  }

  .rules {
    margin-top: var(--s7);
  }

  .rule-text {
    font-size: var(--text-ui);
    line-height: 1.55;
    color: var(--fog);
    text-wrap: pretty;
  }

  .table {
    min-width: 640px;
  }

  .table thead th {
    font-size: var(--text-ui);
    font-weight: 500;
    color: var(--ink);
  }

  .table tbody th {
    width: 46%;
    font-weight: 400;
    color: var(--text);
  }

  .table .group th {
    padding-top: var(--s6);
    font-weight: 500;
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .table td {
    color: var(--ink);
  }

  .table :global(.yes) {
    color: var(--good);
  }

  .no {
    color: var(--fog);
  }
</style>
