---
import { Image } from "astro:assets"
import Page from "../layouts/Page.astro"
import machines from "../assets/console/machines.png"
import terminals from "../assets/console/terminals.png"
import previews from "../assets/console/previews.png"
import Install from "../components/Install.astro"
import Icon from "../components/Icon.astro"
import Plans from "../components/Plans.astro"
import Closing from "../components/Closing.astro"
import FeatureIndex from "../components/FeatureIndex.astro"
import Addresses from "../components/Addresses.astro"
import Term from "../components/Term.astro"
import { softwareSchema } from "../schema"
import { features } from "../features"
import { compares } from "../compare-data"
import { installerBase, localDomain, previewDomain } from "../site"

const description =
  "Persistent terminals, keyless SSH, public previews and encrypted secrets for all your machines. Free for personal use."

const addresses: [string, string][] = [
  [`3000.studio.${localDomain}`, "The dev server on studio"],
  [`grafana.homelab.${localDomain}`, "Grafana, by name"],
  [`jellyfin.${localDomain}`, "Jellyfin, by a short name"],
  [`studio.${localDomain}`, "Everything studio serves"],
]

const recipe = [
  "# in your sandbox template",
  "$ curl -fsSL \\",
  `    ${installerBase} \\`,
  "    | PB_RECIPE=$TOKEN sh",
  "✓ Paired as sandbox-7",
  "✓ Secrets loaded from sandbox-env",
  `✓ Preview live for 2 hours`,
]

const versus = compares.filter((item) => ["tailscale", "ngrok", "cloudflare-tunnel", "teleport"].includes(item.slug))
---

<Page
  title="Paperboat | Use every machine like it's right in front of you"
  description={description}
  schema={[softwareSchema(Astro.site, description)]}
>
  <section class="hero">
    <div class="wrap">
      <h1 class="h1 hero-title">Use every machine like it's right in front of you</h1>
      <p class="hero-lede">
        Paperboat connects your computers so you can run terminals, share files, create tunnels, and sync secrets and config across them.
      </p>
      <div id="install" class="hero-actions">
        <Install />
      </div>
    </div>
    <figure class="hero-shot">
      <Image
        src={machines}
        alt="The Paperboat console: seven machines, six online, with their addresses, what each is running and this month's bandwidth."
        widths={[1376, 2752]}
        sizes="1376px"
        format="png"
        loading="eager"
      />
    </figure>
  </section>

  <section class="section" aria-label="Why Paperboat">
    <div class="wrap">
      <ul class="three">
        <li>
          <h2 class="h3">Nothing to open</h2>
          <p>No port forwarding, no public IP, no VPN. Your machines find each other from any network.</p>
        </li>
        <li>
          <h2 class="h3">Encrypted end to end</h2>
          <p>Terminals, files and secrets are encrypted between your own machines. We can't read them.</p>
        </li>
        <li>
          <h2 class="h3">One install, every system</h2>
          <p>The same Paperboat on Linux, macOS and Windows. Install it, sign in, and the machine is there.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section-rule" aria-labelledby="terminal-title">
    <div class="wrap">
      <header class="split-head">
        <h2 class="h2" id="terminal-title">Close the laptop. Keep the shell.</h2>
        <div class="split-side">
          <p>Your terminals run on the machine, not on your laptop. Come back hours later, from any computer, and pick up where you left off.</p>
          <a class="more" href="/features/terminal/">Terminals <span aria-hidden="true">→</span></a>
        </div>
      </header>
      <figure class="shot">
        <Image src={terminals} alt="The console's Terminals page: four open terminals on studio, gpu-box and staging, one in use." widths={[1136, 2272]} sizes="1136px" format="png" />
      </figure>
    </div>
  </section>

  <section class="section section-rule" aria-labelledby="private-title">
    <div class="wrap pair">
      <div class="pair-text">
        <h2 class="h2" id="private-title">Every port gets its own address</h2>
        <p>
          Open the dev server on your desktop, or Grafana on the box at home, by name. Real HTTPS, and only you can reach it.
        </p>
        <a class="more" href="/features/private-access/">Private access <span aria-hidden="true">→</span></a>
      </div>
      <Addresses rows={addresses} />
    </div>
  </section>

  <section class="section section-rule" aria-labelledby="preview-title">
    <div class="wrap">
      <header class="split-head">
        <h2 class="h2" id="preview-title">Share what you're building</h2>
        <div class="split-side">
          <p>One command puts localhost on a public link like <code>quiet-river-4821.{previewDomain}</code>. Every request is kept, so you can see and replay it.</p>
          <a class="more" href="/features/previews/">Previews <span aria-hidden="true">→</span></a>
        </div>
      </header>
      <figure class="shot">
        <Image src={previews} alt="The console's Previews page: three live previews on macbook, studio and staging, one visible only to its owner." widths={[1136, 2272]} sizes="1136px" format="png" />
      </figure>
    </div>
  </section>

  <section class="section section-rule" aria-labelledby="recipe-title">
    <div class="wrap pair pair-flip">
      <div class="pair-text">
        <h2 class="h2" id="recipe-title">Every new machine, ready from the start</h2>
        <p>
          Spin up one sandbox or a hundred, for development, agents, pull request reviews or tests. Each joins set up your way, and you can reach
          it from the first second.
        </p>
        <a class="more" href="/features/recipes/">Recipes <span aria-hidden="true">→</span></a>
      </div>
      <Term lines={recipe} title="sandbox-7" />
    </div>
  </section>

  <section class="section section-rule" aria-labelledby="all-title">
    <div class="wrap">
      <header class="split-head">
        <h2 class="h2" id="all-title">Everything in one install</h2>
        <div class="split-side">
          <p>{features.length} features on Linux, macOS and Windows, and every one of them is on the free plan.</p>
          <a class="more" href="/features/">All features <span aria-hidden="true">→</span></a>
        </div>
      </header>
      <FeatureIndex />
    </div>
  </section>

  <section class="section section-rule" aria-labelledby="price-title">
    <div class="wrap">
      <header class="split-head">
        <h2 class="h2" id="price-title">Free for personal use</h2>
        <div class="split-side">
          <p>Every feature is free for personal use, and nothing is ever cut off. Pay for more bandwidth, or for a team.</p>
          <a class="more" href="/pricing/">Pricing <span aria-hidden="true">→</span></a>
        </div>
      </header>
      <Plans />
    </div>
  </section>

  <section class="section section-rule" aria-labelledby="versus-title">
    <div class="wrap">
      <header class="split-head">
        <h2 class="h2" id="versus-title">Coming from another tool?</h2>
        <div class="split-side">
          <p>See what you keep, what you gain, and how to move over.</p>
          <a class="more" href="/compare/">All comparisons <span aria-hidden="true">→</span></a>
        </div>
      </header>
      <ul class="versus">
        {
          versus.map((item) => (
            <li>
              <a href={`/compare/${item.slug}/`}>
                <span class="versus-name">Paperboat vs {item.label}</span>
                <span class="versus-line">{item.tagline}</span>
                <Icon name="arrow-right" size={16} class="versus-arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Closing />
</Page>

<style>
  .pair {
    display: grid;
    gap: var(--s7);
    align-items: center;
  }

  .pair-text {
    display: grid;
    gap: var(--s4);
    justify-items: start;
  }

  .pair-text .h2 {
    max-width: 16ch;
  }

  .pair-text p {
    max-width: 44ch;
    font-size: var(--text-lede);
    line-height: 1.5;
    color: var(--fog);
  }

  @media (min-width: 960px) {
    .pair {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: var(--s8);
    }

    .pair-flip > :first-child {
      order: 1;
    }
  }

  .hero {
    padding-top: clamp(56px, 8vw, 112px);
  }

  .hero-title {
    max-width: 16ch;
  }

  .hero-lede {
    max-width: 48rem;
    margin-top: var(--s5);
    font-size: var(--text-lede);
    line-height: 1.5;
    color: var(--fog);
    text-wrap: balance;
  }

  .hero-actions {
    margin-top: var(--s7);
  }

  /*
   * Shown at the size it was captured (1376 px) so the console's text stays sharp: it starts on the
   * text's left edge and runs off the right side of the screen.
   */
  .hero {
    overflow-x: clip;
  }

  .hero-shot {
    width: 1376px;
    max-width: none;
    margin: clamp(56px, 7vw, 88px) 0 0 max(var(--gutter), calc((100% - var(--max)) / 2));
    border-radius: 12px;
    overflow: hidden;
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgb(20 20 20 / 0.08),
      0 1px 2px rgb(20 20 20 / 0.04),
      0 32px 64px -32px rgb(20 20 20 / 0.18);
  }

  .hero-shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* A phone shows the console's left part at a readable size instead of the whole page shrunk. */
  @media (max-width: 639px) {
    .hero-shot {
      height: 340px;
    }

    .hero-shot :global(img) {
      width: 900px;
      max-width: none;
    }
  }

  .three {
    display: grid;
    gap: var(--s6);
  }

  .three li {
    display: grid;
    gap: var(--s3);
    align-content: start;
  }

  .three p {
    max-width: 38ch;
    color: var(--fog);
  }

  @media (min-width: 900px) {
    .three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
    }

    .three li {
      padding-inline: var(--s6);
      border-left: 1px solid var(--rule);
    }

    .three li:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }

  /* A section's opening: the heading on the left, one short paragraph and a link on the right. */
  .split-head {
    display: grid;
    gap: var(--s4) var(--s8);
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .split-head .h2 {
    max-width: 20ch;
  }

  .split-side {
    display: grid;
    gap: var(--s4);
    align-content: start;
    justify-items: start;
  }

  .split-side p {
    max-width: 54ch;
    font-size: var(--text-body);
    color: var(--fog);
  }

  @media (min-width: 900px) {
    .split-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
    }
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-ui);
    font-weight: 500;
    color: var(--ink);
  }

  .more span {
    transition: transform 0.15s ease;
  }

  .more:hover span {
    transform: translateX(3px);
  }

  .shot {
    width: fit-content;
    max-width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgb(20 20 20 / 0.08),
      0 24px 48px -32px rgb(20 20 20 / 0.18);
  }

  .shot :global(img) {
    display: block;
    width: 1136px;
    max-width: 100%;
    height: auto;
  }

  .versus {
    border-top: 1px solid var(--rule);
  }

  .versus a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--s5);
    align-items: center;
    padding: var(--s5) var(--s2);
    border-bottom: 1px solid var(--rule);
  }

  .versus-name {
    white-space: nowrap;
    font-weight: 500;
    color: var(--ink);
  }

  .versus-line {
    grid-column: 1;
    font-size: var(--text-ui);
    color: var(--fog);
  }

  .versus a :global(.versus-arrow) {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--fog);
    transition: transform 0.15s ease;
  }

  .versus a:hover :global(.versus-arrow) {
    color: var(--ink);
    transform: translateX(3px);
  }

  @media (min-width: 760px) {
    .versus a {
      grid-template-columns: 290px minmax(0, 1fr) auto;
    }

    .versus-line {
      grid-column: 2;
    }

    .versus a :global(.versus-arrow) {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
