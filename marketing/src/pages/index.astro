---
import { Image } from "astro:assets"
import Page from "../layouts/Page.astro"
import machines from "../assets/console/machines.png"
import terminals from "../assets/console/terminals.png"
import previews from "../assets/console/previews.png"
import Install from "../components/Install.astro"
import Icon from "../components/Icon.astro"
import Plans from "../components/Plans.astro"
import Closing from "../components/Closing.astro"
import FeatureIndex from "../components/FeatureIndex.astro"
import { softwareSchema } from "../schema"
import { previewDomain } from "../site"

const description =
  "Persistent terminals, keyless SSH, public previews and encrypted secrets for all your machines. Free for personal use."

const versus = [
  ["tailscale", "Tailscale", "A network for every device. Paperboat is for working on your machines."],
  ["ngrok", "ngrok", "The full tunnel product. Paperboat adds terminals, SSH and files."],
  ["cloudflare-tunnel", "Cloudflare Tunnel", "Fast if your domain is on Cloudflare. Paperboat needs none."],
  ["teleport", "Teleport", "Audited access at company scale. Paperboat is one install."],
]
---

<Page
  title="Paperboat | Use every machine like it's right in front of you"
  description={description}
  schema={[softwareSchema(Astro.site, description)]}
>
  <section class="hero">
    <div class="wrap">
      <h1 class="h1 hero-title">Use every machine like it's right in front of you</h1>
      <p class="hero-lede">
        Terminals, files, ports and secrets from all your machines, in one place. Encrypted end to end, and free for personal use.
      </p>
      <div id="install" class="hero-actions">
        <Install />
      </div>
    </div>
    <figure class="hero-shot">
      <Image
        src={machines}
        alt="The Paperboat console: seven machines, six online, with their addresses, what each is running and this month's bandwidth."
        widths={[1376, 2752]}
        sizes="1376px"
        format="png"
        loading="eager"
      />
    </figure>
  </section>

  <section class="section" aria-label="What changes">
    <div class="wrap">
      <ul class="three">
        <li>
          <h2 class="h3">Close the lid. Keep the shell.</h2>
          <p>Terminals live on the machine, not on your laptop. Come back hours later, from any computer, to the same shell.</p>
        </li>
        <li>
          <h2 class="h3">localhost, now with a link</h2>
          <p>One command gives a local port a public HTTPS address, with every request kept to inspect and replay.</p>
        </li>
        <li>
          <h2 class="h3">Your firewall stays shut</h2>
          <p>SSH, files and private ports reach your machines through any NAT, encrypted end to end.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section-rule" aria-labelledby="terminal-title">
    <div class="wrap">
      <header class="split-head">
        <h2 class="h2" id="terminal-title">Terminals that outlive the connection</h2>
        <div class="split-side">
          <p>Close the laptop, change networks, come back hours later. The shell kept running and shows what you missed.</p>
          <a class="more" href="/features/terminal/">How terminals work <span aria-hidden="true">→</span></a>
        </div>
      </header>
      <figure class="shot">
        <Image src={terminals} alt="The console's Terminals page: four open terminals on studio, gpu-box and staging, one in use." widths={[1136, 2272]} sizes="1136px" format="png" />
      </figure>
    </div>
  </section>

  <section class="section section-rule" aria-labelledby="preview-title">
    <div class="wrap">
      <header class="split-head">
        <h2 class="h2" id="preview-title">Share what you're building</h2>
        <div class="split-side">
          <p>One command puts localhost on a link like <code>quiet-river-4821.{previewDomain}</code>, with every request kept to replay.</p>
          <a class="more" href="/features/previews/">Previews and tunnels <span aria-hidden="true">→</span></a>
        </div>
      </header>
      <figure class="shot">
        <Image src={previews} alt="The console's Previews page: three live previews on macbook, studio and staging, one visible only to its owner." widths={[1136, 2272]} sizes="1136px" format="png" />
      </figure>
    </div>
  </section>

  <section class="section section-rule" aria-labelledby="all-title">
    <div class="wrap">
      <header class="split-head">
        <h2 class="h2" id="all-title">Everything in one install</h2>
        <div class="split-side">
          <p>Twelve features for Linux, macOS and Windows, and every one of them is on the free plan.</p>
          <a class="more" href="/features/">All features <span aria-hidden="true">→</span></a>
        </div>
      </header>
      <FeatureIndex />
    </div>
  </section>

  <section class="section section-rule" aria-labelledby="price-title">
    <div class="wrap">
      <header class="split-head">
        <h2 class="h2" id="price-title">Free for personal use</h2>
        <div class="split-side">
          <p>Every feature is free for personal use. Pay for more relay and edge traffic, or for a team.</p>
          <a class="more" href="/pricing/">Pricing in full <span aria-hidden="true">→</span></a>
        </div>
      </header>
      <Plans />
    </div>
  </section>

  <section class="section section-rule" aria-labelledby="versus-title">
    <div class="wrap">
      <header class="split-head">
        <h2 class="h2" id="versus-title">How it compares</h2>
        <div class="split-side">
          <p>Some of these tools do their one job better. Each comparison says where.</p>
          <a class="more" href="/compare/">All comparisons <span aria-hidden="true">→</span></a>
        </div>
      </header>
      <ul class="versus">
        {
          versus.map(([slug, name, line]) => (
            <li>
              <a href={`/compare/${slug}/`}>
                <span class="versus-name">Paperboat and {name}</span>
                <span class="versus-line">{line}</span>
                <Icon name="arrow-right" size={16} class="versus-arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Closing />
</Page>

<style>
  .hero {
    padding-top: clamp(56px, 8vw, 112px);
  }

  .hero-title {
    max-width: 16ch;
  }

  .hero-lede {
    max-width: 48rem;
    margin-top: var(--s5);
    font-size: var(--text-lede);
    line-height: 1.5;
    color: var(--fog);
    text-wrap: balance;
  }

  .hero-actions {
    margin-top: var(--s7);
  }

  /*
   * Shown at the size it was captured (1376 px) so the console's text stays sharp: it starts on the
   * text's left edge and runs off the right side of the screen.
   */
  .hero {
    overflow-x: clip;
  }

  .hero-shot {
    width: 1376px;
    max-width: none;
    margin: clamp(56px, 7vw, 88px) 0 0 max(var(--gutter), calc((100% - var(--max)) / 2));
    border-radius: 12px;
    overflow: hidden;
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgb(20 20 20 / 0.08),
      0 1px 2px rgb(20 20 20 / 0.04),
      0 32px 64px -32px rgb(20 20 20 / 0.18);
  }

  .hero-shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* A phone shows the console's left part at a readable size instead of the whole page shrunk. */
  @media (max-width: 639px) {
    .hero-shot {
      height: 340px;
    }

    .hero-shot :global(img) {
      width: 900px;
      max-width: none;
    }
  }

  .three {
    display: grid;
    gap: var(--s6);
  }

  .three li {
    display: grid;
    gap: var(--s3);
    align-content: start;
  }

  .three p {
    max-width: 38ch;
    color: var(--fog);
  }

  @media (min-width: 900px) {
    .three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
    }

    .three li {
      padding-inline: var(--s6);
      border-left: 1px solid var(--rule);
    }

    .three li:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }

  /* A section's opening: the heading on the left, one short paragraph and a link on the right. */
  .split-head {
    display: grid;
    gap: var(--s4) var(--s8);
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .split-head .h2 {
    max-width: 20ch;
  }

  .split-side {
    display: grid;
    gap: var(--s4);
    align-content: start;
    justify-items: start;
  }

  .split-side p {
    max-width: 54ch;
    font-size: var(--text-body);
    color: var(--fog);
  }

  @media (min-width: 900px) {
    .split-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
    }
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-ui);
    font-weight: 500;
    color: var(--ink);
  }

  .more span {
    transition: transform 0.15s ease;
  }

  .more:hover span {
    transform: translateX(3px);
  }

  .shot {
    width: fit-content;
    max-width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgb(20 20 20 / 0.08),
      0 24px 48px -32px rgb(20 20 20 / 0.18);
  }

  .shot :global(img) {
    display: block;
    width: 1136px;
    max-width: 100%;
    height: auto;
  }

  .versus {
    border-top: 1px solid var(--rule);
  }

  .versus a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--s5);
    align-items: center;
    padding: var(--s5) var(--s2);
    border-bottom: 1px solid var(--rule);
  }

  .versus-name {
    white-space: nowrap;
    font-weight: 500;
    color: var(--ink);
  }

  .versus-line {
    grid-column: 1;
    font-size: var(--text-ui);
    color: var(--fog);
  }

  .versus a :global(.versus-arrow) {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--fog);
    transition: transform 0.15s ease;
  }

  .versus a:hover :global(.versus-arrow) {
    color: var(--ink);
    transform: translateX(3px);
  }

  @media (min-width: 760px) {
    .versus a {
      grid-template-columns: 290px minmax(0, 1fr) auto;
    }

    .versus-line {
      grid-column: 2;
    }

    .versus a :global(.versus-arrow) {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
