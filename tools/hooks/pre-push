#!/usr/bin/env python3
"""Pre-push: build and vet the Go modules a push touches, on a clean checkout of the pushed commit.

A file left out of a commit (the usual way main stops compiling) passes in a working tree that still
has it, so this builds each pushed commit from `git worktree add` instead. Installed by `make hooks`.
Only modules with changes are checked; a push that touches none is instant. PB_PREPUSH_SKIP=1 skips
(do not push a tree you have not built). PB_PREPUSH_CROSS=1 also builds the cli for darwin and windows.
"""
import fcntl
import os
import subprocess
import sys
from pathlib import Path

ZERO = "0" * 40
MODULES = ("cli", "relay", "tunnel", "server", "helper", "shared")
TIMEOUT = 600


# Git runs hooks with GIT_DIR (and in worktrees GIT_INDEX_FILE etc.) naming the pushing checkout.
# Commands inside the build tree must not inherit them, or `checkout --force` moves the pushing
# checkout's HEAD instead of the build tree's.
REPOSITORY_VARIABLES = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_COMMON_DIR", "GIT_PREFIX", "GIT_OBJECT_DIRECTORY")


def tree_env(env=None):
    return {k: v for k, v in (env or os.environ).items() if k not in REPOSITORY_VARIABLES}


def git(*args, cwd=None, check=True):
    result = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, env=tree_env() if cwd else None)
    if check and result.returncode:
        raise RuntimeError(f"git {' '.join(args)}: {result.stderr.strip()}")
    return result.stdout


def changed_paths(local, remote):
    if remote != ZERO and subprocess.run(["git", "cat-file", "-e", remote + "^{commit}"], capture_output=True).returncode == 0:
        base = remote
    else:
        # A new branch or an unknown remote tip: compare with what origin/main already has.
        base = git("merge-base", local, "origin/main", check=False).strip()
    if not base:
        return None
    return [p for p in git("diff", "--name-only", f"{base}..{local}").splitlines() if p]


def touched(paths):
    if paths is None or any(p in ("go.work", "go.work.sum") for p in paths):
        return list(MODULES)
    return [m for m in MODULES if any(p.startswith(m + "/") for p in paths)]


def run(argv, cwd, env=None):
    result = subprocess.run(argv, cwd=cwd, capture_output=True, text=True, timeout=TIMEOUT, env=tree_env(env))
    return result.returncode, (result.stdout + result.stderr).strip()


def packages_with_files(module_dir, dirs, tests):
    """The directories (relative to the module, './'-prefixed) that still hold Go files Go would compile.

    A diff also names directories whose Go files were all deleted, or that only have _test.go files, or
    only files for another OS; `go build ./dir` fails on those although the module builds. Go decides
    what counts (`go list -e` reports no files for them), so the hook builds exactly what Go can build
    (tests=False) or vet (tests=True) among the changed directories.
    """
    targets = ["./" + d if d != "." else "." for d in dirs]
    template = "{{.Dir}}\t{{len .GoFiles}}\t{{len .CgoFiles}}\t{{len .TestGoFiles}}\t{{len .XTestGoFiles}}"
    code, output = run(["go", "list", "-e", "-f", template, *targets], module_dir)
    if code:
        raise RuntimeError(f"go list {' '.join(targets)}: {output}")
    found = []
    for line in output.splitlines():
        directory, *counts = line.split("\t")
        if directory and sum(int(n) for n in (counts if tests else counts[:2])):
            found.append("./" + os.path.relpath(directory, module_dir) if directory != str(module_dir) else ".")
    return found


def checkout_tree(commit):
    """One persistent detached worktree per repository: a stable path keeps Go's build cache warm."""
    common = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir").strip())
    tree = common / "pb-prepush-tree"
    if tree.exists():
        git("checkout", "--detach", "--force", "--quiet", commit, cwd=tree)
    else:
        git("worktree", "add", "--detach", "--quiet", str(tree), commit)
    git("clean", "-fdxq", cwd=tree)
    return tree


def go_key(commit, module, packages):
    """What a module's build and vet depend on: every Go module's tree, go.work and the vetted packages.

    A rebase that only brings in console, docs or CHECKLIST commits keeps the key, so a push that lost a
    race is not rebuilt from scratch.
    """
    parts = [git("rev-parse", "--verify", "--quiet", f"{commit}:{name}", check=False).strip() for name in (*MODULES, "go.work", "go.work.sum")]
    return " ".join([module, *parts, *packages])


def check(commit, modules, paths):
    failures = []
    common = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir").strip())
    passed = common / "pb-prepush-passed"
    with open(common / "pb-prepush.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)  # concurrent pushes from several worktrees take turns
        known = set(passed.read_text().splitlines()) if passed.exists() else set()
        tree = None
        for module in modules:
            changed_go = sorted({str(Path(p).parent.relative_to(module)) for p in (paths or []) if p.startswith(module + "/") and p.endswith(".go")}) if paths is not None else ["."]
            key = go_key(commit, module, changed_go)
            if key in known:
                print(f"pre-push: {module} unchanged since it last passed; not rebuilt", file=sys.stderr)
                continue
            tree = tree or checkout_tree(commit)
            if not (tree / module / "go.mod").exists():
                continue
            before = len(failures)
            # Only the packages the push changed: a file left out of a commit breaks its own package,
            # and building every package of a module took 15-30 min at load 50 on the shared 4-CPU box.
            # Breakage further up the import graph is CI's job (.github/workflows).
            if not changed_go:
                continue
            # Without a base to diff against (paths is None) the whole module is built.
            buildable = ["./..."] if paths is None else packages_with_files(tree / module, changed_go, tests=False)
            if buildable:
                code, output = run(["go", "build", *buildable], tree / module)
                if code:
                    failures.append(f"{module}: go build failed\n{output}")
                    continue
            vettable = ["./..."] if paths is None else packages_with_files(tree / module, changed_go, tests=True)
            if vettable:
                code, output = run(["go", "vet", *vettable], tree / module)
                if code:
                    failures.append(f"{module}: go vet failed\n{output}")
            if module == "cli" and os.environ.get("PB_PREPUSH_CROSS") == "1":
                for goos in ("darwin", "windows"):
                    code, output = run(["go", "build", "./..."], tree / module, dict(os.environ, GOOS=goos, CGO_ENABLED="0"))
                    if code:
                        failures.append(f"cli: GOOS={goos} go build ./... failed\n{output}")
            if len(failures) == before and os.environ.get("PB_PREPUSH_CROSS") != "1":
                with open(passed, "a") as record:
                    record.write(key + "\n")
    return failures


def main():
    if os.environ.get("PB_PREPUSH_SKIP") == "1":
        print("pre-push: skipped (PB_PREPUSH_SKIP=1)", file=sys.stderr)
        return 0
    failed = False
    for line in sys.stdin.read().splitlines():
        parts = line.split()
        if len(parts) != 4:
            continue
        _, local, _, remote = parts
        if local == ZERO:
            continue  # deleting a ref
        try:
            paths = changed_paths(local, remote)
            modules = touched(paths)
            if not modules:
                continue
            print(f"pre-push: building {', '.join(modules)} at {local[:10]} on a clean checkout", file=sys.stderr)
            failures = check(local, modules, paths)
        except (RuntimeError, subprocess.TimeoutExpired) as error:
            failures = [f"could not check the pushed commit: {error}"]
        for failure in failures:
            failed = True
            print(f"pre-push: {failure}", file=sys.stderr)
    if failed:
        print("pre-push: push refused. Fix the build (did a file miss `git add`?) and push again.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
