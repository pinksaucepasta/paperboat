PAPERBOAT_DATABASE_DSN=postgres://paperboat:change-me@database.example.test:5432/paperboat?sslmode=require
PAPERBOAT_SERVER_IMAGE=ghcr.io/pinksaucepasta/paperboat/server:latest
PAPERBOAT_PUBLIC_BASE_URL=https://pb.example.test
PAPERBOAT_ALLOWED_ORIGINS=https://dashboard.example.test
PAPERBOAT_WORKOS_BASE_URL=https://api.workos.com
PAPERBOAT_OPERATOR_EMAIL=pprbtdev@gmail.com
# This must equal the host-runtime route base in the paperboat-tunnel
# deployment overlay. The durable managed tunnel endpoint uses the separate
# opaque-UUID wildcard below.
PAPERBOAT_RUNTIME_BASE_DOMAIN=runtime.example.test
PAPERBOAT_LOCAL_ACCESS_BASE_DOMAIN=local.example.test
PAPERBOAT_RELEASES_ROOT_PATH=/opt/paperboat/releases
PAPERBOAT_RELEASE_DIRECTORY=/srv/paperboat-releases/current
PAPERBOAT_RELEASE_BASE_URL=https://get.example.test
PAPERBOAT_USER_MACHINES_HELPER_LISTEN_PORT=38080
# These must equal the corresponding public bases in the paperboat-tunnel
# deployment overlay.
PAPERBOAT_PREVIEW_BASE_DOMAIN=public.example.test
PAPERBOAT_TUNNEL_BASE_DOMAIN=public.example.test

# Production requires managed certificates. Configure every reference below
# and pass the deployment-readiness gates in
# docs/runbooks/preview-tunnel-control-plane.md before starting the server.
# These are references and public settings only. Never put a PEM, private key,
# DNS token, master key, or edge credential value in this file.
PAPERBOAT_CERTIFICATES_ENABLED=true
PAPERBOAT_CERTIFICATES_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
PAPERBOAT_CERTIFICATES_ACCOUNT_KID=
PAPERBOAT_CERTIFICATES_ACCOUNT_EMAIL=admin@example.com
PAPERBOAT_CERTIFICATES_ISSUER=letsencrypt
PAPERBOAT_CERTIFICATES_ACCOUNT_KEY_REFERENCE=secret://acme/account
PAPERBOAT_CERTIFICATES_MASTER_KEY_REFERENCE=secret://paperboat/master
PAPERBOAT_CERTIFICATES_DNS_PROVIDER=cloudflare
PAPERBOAT_CERTIFICATES_PUBLIC_DNS_ZONE_ID=
PAPERBOAT_CERTIFICATES_DNS_ZONE_ID=replace-with-cloudflare-zone-id
PAPERBOAT_CERTIFICATES_DNS_TOKEN_REFERENCE=secret://cloudflare/dns
PAPERBOAT_CERTIFICATES_CHALLENGE_ZONE=challenges.example.com
PAPERBOAT_CERTIFICATES_CAA_RESOLVER=1.1.1.1:53
PAPERBOAT_CERTIFICATES_DISTRIBUTION_CREDENTIAL_REFERENCE=secret://edge/distribution
PAPERBOAT_CERTIFICATES_OWNER_ID=server_01
PAPERBOAT_CERTIFICATES_RENEW_BEFORE=720h
PAPERBOAT_CERTIFICATES_LOCK_TTL=5m
PAPERBOAT_CERTIFICATES_DISTRIBUTION_TIMEOUT=2m
PAPERBOAT_CERTIFICATES_EXPIRY_ALERT_WINDOW=168h
PAPERBOAT_CERTIFICATES_MAX_LIFETIME=2160h
PAPERBOAT_CERTIFICATES_ACME_TIMEOUT=5m
PAPERBOAT_CERTIFICATES_PROPAGATION_TIMEOUT=5m
PAPERBOAT_CERTIFICATES_CLEANUP_TIMEOUT=1m
PAPERBOAT_CERTIFICATES_POLL_INTERVAL=10s
PAPERBOAT_CERTIFICATES_RETRY_BASE=1m
PAPERBOAT_CERTIFICATES_RETRY_MAX=2m
PAPERBOAT_CERTIFICATES_MAX_ATTEMPTS=5

# Runtime-only secret injection uses the reference-name function, not the
# reference value: uppercase each alphanumeric rune, replace every other rune
# with _, then append _ plus the first 12 lowercase hex characters of SHA-256
# of the original reference. For example, these names contain no secret bytes:
#   secret://acme/account       -> PAPERBOAT_CERT_SECRET_SECRET___ACME_ACCOUNT_27c59c1f5611
#   secret://paperboat/master   -> PAPERBOAT_CERT_SECRET_SECRET___PAPERBOAT_MASTER_9212b6737cae
#   secret://cloudflare/dns     -> PAPERBOAT_CERT_SECRET_SECRET___CLOUDFLARE_DNS_f9b5f91598d2
#   secret://edge/distribution  -> PAPERBOAT_CERT_SECRET_SECRET___EDGE_DISTRIBUTION_db21dd9c8bbf
# Inject only the referenced bytes under those generated names at server
# startup. The distribution reference must resolve to exactly the same bytes
# loaded by PAPERBOAT_EDGE_CONTROL_CREDENTIAL_FILE.

PAPERBOAT_DIAGNOSTICS_OBJECT_ENDPOINT=https://fsn1.your-objectstorage.com
PAPERBOAT_DIAGNOSTICS_OBJECT_REGION=fsn1
PAPERBOAT_DIAGNOSTICS_OBJECT_BUCKET=paperboat-diagnostics
PAPERBOAT_DIAGNOSTICS_FORCE_PATH_STYLE=true
PAPERBOAT_DIAGNOSTICS_RETENTION=168h
PAPERBOAT_CONFIG_SYNC_MODE=disabled
PAPERBOAT_MINT_ACTIVE_KEY_ID=current
PAPERBOAT_SESSION_KEYS_FILE=/run/secrets/paperboat_session_keys
PAPERBOAT_MINT_SIGNING_KEYS_FILE=/run/secrets/paperboat_mint_signing_keys
PAPERBOAT_ENCRYPTION_KEY_FILE=/run/secrets/paperboat_encryption_key
PAPERBOAT_WORKOS_API_KEY_FILE=/run/secrets/paperboat_workos_api_key
PAPERBOAT_WORKOS_CLIENT_ID_FILE=/run/secrets/paperboat_workos_client_id
PAPERBOAT_GITHUB_CLIENT_ID_FILE=/run/secrets/paperboat_github_client_id
PAPERBOAT_GITHUB_CLIENT_SECRET_FILE=/run/secrets/paperboat_github_client_secret
PAPERBOAT_GITHUB_APP_ID=
PAPERBOAT_EDGE_CONTROL_CREDENTIAL_FILE=/run/secrets/paperboat_edge_control_credential
PAPERBOAT_DIAGNOSTICS_ACCESS_KEY_FILE=/run/secrets/paperboat_diagnostics_access_key
PAPERBOAT_DIAGNOSTICS_SECRET_KEY_FILE=/run/secrets/paperboat_diagnostics_secret_key
ACME_EMAIL=admin@example.com

# Task 36.9 Stripe test setup. Live credentials are rejected by the workspace client.
# PAPERBOAT_STRIPE_API_KEY_FILE=/run/secrets/stripe_test_api_key
# PAPERBOAT_STRIPE_WEBHOOK_SECRET_FILE=/run/secrets/stripe_test_webhook_secret

# Startup browser-session policy (duration strings; existing defaults shown).
# PAPERBOAT_BROWSER_SESSIONS_LOGIN_LIFETIME=720h
# PAPERBOAT_BROWSER_SESSIONS_LOGIN_ROTATE_BEFORE=168h
# PAPERBOAT_BROWSER_SESSIONS_RESOURCE_ABSOLUTE_LIFETIME=12h
# PAPERBOAT_BROWSER_SESSIONS_RESOURCE_IDLE_LIFETIME=30m

# Official release images report sanitized errors and operational signals to
# Paperboat by default. Self-built images have no embedded destination.
# Set this explicitly to opt out of reporting in an official image.
# PAPERBOAT_SENTRY_ENABLED=false
# PAPERBOAT_SENTRY_DSN=https://public@example.sentry.invalid/1
# PAPERBOAT_SENTRY_RELEASE=paperboat-server:2026.09.19.1
PAPERBOAT_SENTRY_ISSUE_URL=

# Admin Sentry API is separate from event ingestion. Leave all four unset until
# a project-scoped read-only integration token is installed via secret file.
# PAPERBOAT_SENTRY_API_BASE_URL=https://sentry.io
# PAPERBOAT_SENTRY_ORGANIZATION=paperboat
# PAPERBOAT_SENTRY_PROJECTS=paperboat-server,paperboat-native,paperboat-relay,paperboat-tunnel
# PAPERBOAT_SENTRY_LOGS_ENABLED=true
# PAPERBOAT_SENTRY_METRICS_ENABLED=true
# PAPERBOAT_SENTRY_TRACES_SAMPLE_RATE=0.1
# PAPERBOAT_SENTRY_API_TOKEN_FILE=/run/secrets/sentry-admin-read

# Backup evidence is reported by the deployment-owned paperboat-backup producer.
# Missing token means not_configured; database readiness is never backup evidence.
PAPERBOAT_BACKUP_DATABASE_ID=primary
PAPERBOAT_BACKUP_MAX_AGE_SECONDS=93600
PAPERBOAT_BACKUP_RESTORE_MAX_AGE_SECONDS=691200
# PAPERBOAT_BACKUP_REPORT_TOKEN_FILE=/run/secrets/backup-report-token
