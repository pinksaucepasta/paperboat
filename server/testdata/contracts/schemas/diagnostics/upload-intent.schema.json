{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.paperboat.dev/diagnostics/upload-intent.schema.json",
  "title": "Paperboat diagnostic upload intent v1",
  "$defs": {
    "categories": {
      "type": "array",
      "prefixItems": [{ "const": "manifest" }, { "const": "recent_events" }, { "const": "redacted_events" }, { "const": "status" }],
      "minItems": 4,
      "maxItems": 4
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "correlation_id", "bytes", "sha256", "categories"],
      "properties": {
        "schema": { "const": "paperboat.diagnostic-upload-intent-request/v1" },
        "correlation_id": { "type": "string", "pattern": "^support_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 26214400 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "categories": { "$ref": "#/$defs/categories" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "intent_id", "correlation_id", "state", "expires_at"],
      "properties": {
        "schema": { "const": "paperboat.diagnostic-upload-intent/v1" },
        "intent_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
        "correlation_id": { "type": "string", "pattern": "^support_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "state": { "enum": ["pending", "uploaded"] },
        "expires_at": { "type": "string", "format": "date-time" },
        "upload_method": { "const": "PUT" },
        "upload_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "upload_headers": { "type": "object", "minProperties": 1, "maxProperties": 8, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 1024 } }
      },
      "allOf": [{ "if": { "properties": { "state": { "const": "pending" } }, "required": ["state"] }, "then": { "required": ["upload_method", "upload_url", "upload_headers"] } }]
    }
  },
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/response" }]
}
