{
  "environment": "development",
  "runtime_base_domain": "runtime.paperboat.local",
  "tunnel": {
    "base_domain": "tunnels.paperboat.local"
  },
  "http": {
    "address": "127.0.0.1:8080",
    "public_base_url": "http://127.0.0.1:8080",
    "allowed_origins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ],
    "read_header_timeout": 5000000000,
    "request_timeout": 15000000000,
    "shutdown_timeout": 10000000000,
    "max_body_bytes": 1048576,
    "trusted_proxy_cidrs": []
  },
  "database": {
    "driver": "postgres",
    "dsn": "postgres://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable"
  },
  "billing": {
    "personal_allowance_bytes": null,
    "team_allowance_bytes": null,
    "personal_machine_limit": null
  },
  "user_machines": {
    "pairing_lifetime": 600000000000,
    "offline_after": 120000000000,
    "allowed_platforms": [
      "darwin",
      "linux"
    ],
    "runtime_listen_port": 38080
  },
  "terminal_sessions": {
    "operation_timeout": 15000000000,
    "retry_backoff": 1000000000,
    "worker_interval": 1000000000,
    "max_attempts_before_alert": 10
  },
  "cli_auth": {
    "verification_url": "http://localhost:3000/cli/authorize",
    "client_id": "paperboat",
    "allowed_scopes": [
      "account:read",
      "clients:revoke",
      "machines:read",
      "machines:connect",
      "session:refresh",
      "diagnostics:upload",
      "previews:read",
      "previews:write",
      "tunnels:read",
      "tunnels:write",
      "operations:read",
      "operations:write"
    ],
    "mint_active_key_id": "",
    "mint_jwks_max_age": 3600000000000,
    "mint_proof_lifetime": 120000000000,
    "device_grant_lifetime": 600000000000,
    "access_token_lifetime": 900000000000,
    "refresh_token_lifetime": 2592000000000000,
    "poll_interval": 5000000000,
    "max_client_label_length": 120,
    "network_requests_per_minute": 30,
    "grant_polls_per_minute": 30,
    "account_actions_per_minute": 30
  },
  "github": {
    "oauth_authorize_url": "https://github.com/login/oauth/authorize",
    "oauth_token_url": "https://github.com/login/oauth/access_token",
    "oauth_scopes": [
      "repo"
    ],
    "config_repo_name": "paperboat-config",
    "config_repo_branch": "main"
  },
  "access": {
    "route_subdomain_prefix": "pb",
    "connect_ready_timeout": 2000000000,
    "connect_poll_interval": 100000000
  },
  "diagnostics": {
    "object_endpoint": "",
    "object_region": "",
    "object_bucket": "",
    "force_path_style": false,
    "retention": 604800000000000
  },
  "providers": {},
  "secrets": {
    "session_keys": [
      "development-session-key-change-me"
    ],
    "encryption_key": "development-encryption-key-change-me"
  },
  "browser_sessions": {
    "login_lifetime": 2592000000000000,
    "login_rotate_before": 604800000000000,
    "resource_absolute_lifetime": 43200000000000,
    "resource_idle_lifetime": 1800000000000
  }
}
