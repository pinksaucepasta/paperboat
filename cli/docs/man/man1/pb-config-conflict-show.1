.nh
.TH "PB-CONFIG-CONFLICT-SHOW" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-config-conflict-show - Show a current path conflict


.SH SYNOPSIS
\fBpb config conflict show   [flags]\fP


.SH DESCRIPTION
Show a current path conflict

.PP
JSON output is supported with --json.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for show

.PP
\fB--json\fP[=false]
	print JSON


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to the CLI config file

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	paperboat-server base URL override


.SH SEE ALSO
\fBpb-config-conflict(1)\fP
