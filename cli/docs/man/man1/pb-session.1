.nh
.TH "PB-SESSION" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-session - Manage environment terminal sessions


.SH SYNOPSIS
\fBpb session [flags]\fP


.SH DESCRIPTION
Manage environment terminal sessions

.PP
With --json, this command group lists its available commands.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for session


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to the CLI config file

.PP
\fB--json\fP[=false]
	print machine-readable JSON

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	paperboat-server base URL override


.SH SEE ALSO
\fBpb(1)\fP, \fBpb-session-attach(1)\fP, \fBpb-session-close(1)\fP, \fBpb-session-delete(1)\fP, \fBpb-session-join(1)\fP, \fBpb-session-list(1)\fP, \fBpb-session-participants(1)\fP, \fBpb-session-remove(1)\fP, \fBpb-session-rename(1)\fP, \fBpb-session-share(1)\fP, \fBpb-session-shared(1)\fP, \fBpb-session-unshare(1)\fP
