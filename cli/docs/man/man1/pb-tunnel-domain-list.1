.nh
.TH "PB-TUNNEL-DOMAIN-LIST" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-tunnel-domain-list - List tunnel domains


.SH SYNOPSIS
\fBpb tunnel domain list <tunnel> [flags]\fP


.SH DESCRIPTION
List the hostnames a durable tunnel is served at, with the certificate state of each. Add
hostnames with pb tunnel domain add and withdraw them with pb tunnel domain remove.

.PP
JSON output is supported with --json.


.SH OPTIONS
\fB--cursor\fP=""
	continue a previous page

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--json\fP[=false]
	print canonical JSON

.PP
\fB--limit\fP=100
	maximum results (1-200)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to the CLI config file

.PP
\fB--ephemeral\fP[=false]
	use the temporary preview lifecycle

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	paperboat-server base URL override

.PP
\fB--workspace\fP=""
	resource workspace selector: personal or a team slug


.SH EXAMPLE
.EX
  pb tunnel domain list web
  pb tunnel domain list web --json
.EE


.SH SEE ALSO
\fBpb-tunnel-domain(1)\fP
