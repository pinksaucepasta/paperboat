.nh
.TH "PB-CONFIG-CONFLICT-LIST" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-config-conflict-list - List current path conflicts


.SH SYNOPSIS
\fBpb config conflict list [environment] [flags]\fP


.SH DESCRIPTION
List current path conflicts

.PP
JSON output is supported with --json.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--json\fP[=false]
	print JSON


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to the CLI config file

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	paperboat-server base URL override


.SH SEE ALSO
\fBpb-config-conflict(1)\fP
