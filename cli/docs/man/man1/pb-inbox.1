.nh
.TH "PB-INBOX" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-inbox - Manage the Paperboat Inbox


.SH SYNOPSIS
\fBpb inbox [flags]\fP


.SH DESCRIPTION
Manage the Paperboat Inbox

.PP
With --json, this command group lists its available commands.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for inbox


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to the CLI config file

.PP
\fB--json\fP[=false]
	print machine-readable JSON

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	paperboat-server base URL override


.SH SEE ALSO
\fBpb(1)\fP, \fBpb-inbox-approve(1)\fP, \fBpb-inbox-decline(1)\fP, \fBpb-inbox-path(1)\fP, \fBpb-inbox-policy(1)\fP, \fBpb-inbox-requests(1)\fP, \fBpb-inbox-reset(1)\fP, \fBpb-inbox-set(1)\fP
