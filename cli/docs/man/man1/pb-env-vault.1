.TH "PB-ENV-VAULT" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-env-vault - Manage password-protected ENV key custody


.SH SYNOPSIS
\fBpb env vault [flags]\fP


.SH DESCRIPTION
Manage password-protected ENV key custody

.PP
With --json, this command group lists its available commands.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for vault


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to the CLI config file

.PP
\fB--json\fP[=false]
	print machine-readable JSON

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	paperboat-server base URL override


.SH SEE ALSO
\fBpb-env(1)\fP, \fBpb-env-vault-init(1)\fP, \fBpb-env-vault-lock(1)\fP, \fBpb-env-vault-password(1)\fP, \fBpb-env-vault-recover(1)\fP, \fBpb-env-vault-recovery(1)\fP, \fBpb-env-vault-remove(1)\fP, \fBpb-env-vault-reset(1)\fP, \fBpb-env-vault-resume(1)\fP, \fBpb-env-vault-unlock(1)\fP
