.nh
.TH "PB-SEND-DESTINATION" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-send-destination - Show the default transfer destination


.SH SYNOPSIS
\fBpb send destination [flags]\fP


.SH DESCRIPTION
Show the saved default machine for pb send, or with --session the destination saved for one
terminal session. --to on a single send overrides it. This setting only chooses where your
sends go; it does not change any Inbox directory.

.PP
JSON output is supported with --json.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for destination

.PP
\fB--json\fP[=false]
	print JSON

.PP
\fB--session\fP=""
	terminal session ID for a session-specific destination


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to the CLI config file

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	paperboat-server base URL override

.PP
\fB--workspace\fP=""
	resource workspace selector: personal or a team slug


.SH EXAMPLE
.EX
  pb send destination
  pb send destination --session S123 --json
.EE


.SH SEE ALSO
\fBpb-send(1)\fP, \fBpb-send-destination-clear(1)\fP, \fBpb-send-destination-set(1)\fP
