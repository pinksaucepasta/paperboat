.TH "PB-DAEMON-DEVICE-GUARD" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-daemon-device-guard - Manage protected device-name access


.SH SYNOPSIS
\fBpb daemon device-guard [flags]\fP


.SH DESCRIPTION
Manage protected device-name access

.PP
With --json, this command group lists its available commands.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for device-guard


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	configuration file

.PP
\fB--json\fP[=false]
	print machine-readable JSON

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	Paperboat server URL


.SH SEE ALSO
\fBpb-daemon(1)\fP, \fBpb-daemon-device-guard-install(1)\fP, \fBpb-daemon-device-guard-run(1)\fP, \fBpb-daemon-device-guard-uninstall(1)\fP
