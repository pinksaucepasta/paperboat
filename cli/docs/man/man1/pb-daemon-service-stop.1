.nh
.TH "PB-DAEMON-SERVICE-STOP" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-daemon-service-stop - Stop Paperboat daemon current-user service


.SH SYNOPSIS
\fBpb daemon service stop [flags]\fP


.SH DESCRIPTION
Stop Paperboat daemon current-user service

.PP
JSON output is supported with --json.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for stop

.PP
\fB--json\fP[=false]
	print JSON


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	configuration file

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	Paperboat server URL


.SH SEE ALSO
\fBpb-daemon-service(1)\fP
