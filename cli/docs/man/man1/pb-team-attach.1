.nh
.TH "PB-TEAM-ATTACH" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-team-attach - Attach or detach an explicitly selected personal resource


.SH SYNOPSIS
\fBpb team attach    [flags]\fP


.SH DESCRIPTION
Attach or detach an explicitly selected personal resource

.PP
JSON output is supported with --json.


.SH OPTIONS
\fB--active\fP[=true]
	attach resource; set false to detach

.PP
\fB--generation\fP=0
	expected current team generation

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for attach

.PP
\fB--json\fP[=false]
	print canonical JSON


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to the CLI config file

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	paperboat-server base URL override


.SH SEE ALSO
\fBpb-team(1)\fP
