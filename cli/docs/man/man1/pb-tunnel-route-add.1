.nh
.TH "PB-TUNNEL-ROUTE-ADD" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-tunnel-route-add - Add a tunnel route


.SH SYNOPSIS
\fBpb tunnel route add <tunnel> [flags]\fP


.SH DESCRIPTION
Add a route to a durable tunnel. --name and --to are required: --to is the origin URL the route forwards to. --domain is
the hostname it matches (an exact name or a one-label wildcard) and --path an optional HTTP path
prefix, which may end in *. --protocol is http (the default), tcp, tls passthrough or
tcp_private.

.PP
Origin options: --host-header or --preserve-host choose the Host the app sees; --tls-verification
(system, custom_ca, pinned or insecure) with --tls-ca, --tls-pin and --tls-server-name decide
how the origin's certificate is trusted; --connect-timeout (default 10s), --idle-timeout
(default 5m) and --max-streams (default 1024) bound the connection. Header, redirect and
path-rewrite rules are repeatable (--request-header and --response-header up to 8, --redirect up
to 4).

.PP
A change returns once the request is accepted, and the tunnel may still be connecting. Pass
--wait to wait (at most --timeout, default 2m, 1s to 10m) until it finishes, or check pb tunnel
status.

.PP
JSON output is supported with --json.


.SH OPTIONS
\fB--clear-client-credential-reference\fP[=false]
	remove the origin mTLS credential reference

.PP
\fB--clear-host-header\fP[=false]
	remove the origin Host override

.PP
\fB--clear-tls-server-name\fP[=false]
	remove the explicit origin TLS server name

.PP
\fB--client-credential-reference\fP=""
	protected origin mTLS credential reference

.PP
\fB--connect-timeout\fP=10s
	origin connect timeout

.PP
\fB--domain\fP=""
	exact hostname or one-label wildcard match

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for add

.PP
\fB--host-header\fP=""
	override the origin Host header

.PP
\fB--idle-timeout\fP=5m0s
	stream idle timeout

.PP
\fB--json\fP[=false]
	print canonical JSON

.PP
\fB--max-streams\fP=1024
	maximum concurrent streams

.PP
\fB--name\fP=""
	route name (required)

.PP
\fB--path\fP=""
	HTTP path prefix, optionally ending in *

.PP
\fB--preserve-host\fP[=true]
	preserve the incoming Host header

.PP
\fB--priority\fP=0
	route priority

.PP
\fB--protocol\fP="http"
	route protocol (http, tcp, tls passthrough, or tcp_private)

.PP
\fB--redirect\fP=[]
	redirect a path prefix: '/from -> [301|302|307|308:]/to-or-https-URL' (repeatable, at most 4)

.PP
\fB--request-header\fP=[]
	request header rule op:Name=value (op add or set) or remove:Name, sent to the app (repeatable, at most 8)

.PP
\fB--response-header\fP=[]
	response header rule op:Name=value (op add or set) or remove:Name, sent to the visitor (repeatable, at most 8)

.PP
\fB--rewrite-path\fP=[]
	rewrite a path prefix before the app sees it: '/from -> /to'

.PP
\fB--timeout\fP=2m0s
	maximum time to wait for operation completion

.PP
\fB--tls-ca\fP=""
	trust this CA for the origin (PEM file, e.g. Caddy's tls internal root); sets custom_ca

.PP
\fB--tls-pin\fP=""
	pin the origin certificate by its fingerprint (sha256:<hex>), without connecting

.PP
\fB--tls-server-name\fP=""
	explicit origin TLS server name

.PP
\fB--tls-verification\fP=""
	origin TLS verification: system, custom_ca, pinned (shows the origin certificate and pins it), or insecure

.PP
\fB--to\fP=""
	origin URL the route forwards to (required)

.PP
\fB--wait\fP[=false]
	wait for the operation to reach a terminal state


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to the CLI config file

.PP
\fB--ephemeral\fP[=false]
	use the temporary preview lifecycle

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	paperboat-server base URL override

.PP
\fB--workspace\fP=""
	resource workspace selector: personal or a team slug


.SH EXAMPLE
.EX
  pb tunnel route add web --name app --to http://127.0.0.1:8080 --domain app.example.com
  pb tunnel route add web --name db --protocol tcp --to tcp://127.0.0.1:5432 --domain db.example.com
  pb tunnel route add web --name docs --to http://127.0.0.1:3000 --domain app.example.com --path /docs --wait
.EE


.SH SEE ALSO
\fBpb-tunnel-route(1)\fP
