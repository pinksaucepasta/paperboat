.nh
.TH "PB-DAEMON-RUN" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-daemon-run - Run Paperboat daemon under service supervision


.SH SYNOPSIS
\fBpb daemon run [flags]\fP


.SH DESCRIPTION
Run Paperboat daemon under service supervision

.PP
This command does not support --json output; it rejects that mode before execution. Use --help --json for structured command help.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for run


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	configuration file

.PP
\fB--json\fP[=false]
	print machine-readable JSON

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	Paperboat server URL


.SH SEE ALSO
\fBpb-daemon(1)\fP
