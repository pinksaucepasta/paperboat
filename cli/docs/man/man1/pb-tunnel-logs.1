.nh
.TH "PB-TUNNEL-LOGS" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-tunnel-logs - Show tunnel logs


.SH SYNOPSIS
\fBpb tunnel logs <tunnel> [flags]\fP


.SH DESCRIPTION
Show recent events of a tunnel, 1 to 200 per page (--limit, default 100; --cursor continues).
--follow waits for new entries every --interval (250ms to 1m, default 1s). Logs explain what
happened; for the current state use pb tunnel status.

.PP
JSON output is supported with --json.


.SH OPTIONS
\fB--cursor\fP=""
	continue after a log cursor

.PP
\fB--follow\fP[=false]
	wait for new log entries

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for logs

.PP
\fB--interval\fP=1s
	follow polling interval (250ms-1m)

.PP
\fB--json\fP[=false]
	print canonical JSON

.PP
\fB--limit\fP=100
	maximum entries per request (1-200)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to the CLI config file

.PP
\fB--ephemeral\fP[=false]
	use the temporary preview lifecycle

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	paperboat-server base URL override

.PP
\fB--workspace\fP=""
	resource workspace selector: personal or a team slug


.SH EXAMPLE
.EX
  pb tunnel logs web
  pb tunnel logs web --follow --interval 5s
  pb tunnel logs web --limit 50 --json
.EE


.SH SEE ALSO
\fBpb-tunnel(1)\fP
