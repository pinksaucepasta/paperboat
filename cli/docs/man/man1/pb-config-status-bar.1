.TH "PB-CONFIG-STATUS-BAR" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-config-status-bar - Configure the interactive terminal status bar


.SH SYNOPSIS
\fBpb config status-bar [flags]\fP


.SH DESCRIPTION
Configure the interactive terminal status bar

.PP
With --json, this command group lists its available commands.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for status-bar


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to the CLI config file

.PP
\fB--json\fP[=false]
	print machine-readable JSON

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	paperboat-server base URL override


.SH SEE ALSO
\fBpb-config(1)\fP, \fBpb-config-status-bar-preview(1)\fP, \fBpb-config-status-bar-reset(1)\fP, \fBpb-config-status-bar-set(1)\fP, \fBpb-config-status-bar-show(1)\fP
