.nh
.TH "PB-TEAM-CANCEL-INVITE" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-team-cancel-invite - Cancel an outstanding invitation


.SH SYNOPSIS
\fBpb team cancel-invite   [flags]\fP


.SH DESCRIPTION
Cancel an outstanding invitation

.PP
JSON output is supported with --json.


.SH OPTIONS
\fB--generation\fP=0
	expected current team generation

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for cancel-invite

.PP
\fB--json\fP[=false]
	print canonical JSON


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to the CLI config file

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	paperboat-server base URL override


.SH SEE ALSO
\fBpb-team(1)\fP
