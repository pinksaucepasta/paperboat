.nh
.TH "PB-TUNNEL" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-tunnel - Manage durable tunnels or start an ephemeral tunnel


.SH SYNOPSIS
\fBpb tunnel [--ephemeral] [] [flags]\fP


.SH DESCRIPTION
Manage durable tunnels or start an ephemeral tunnel

.PP
JSON output is supported with --json.


.SH OPTIONS
\fB--background\fP[=false]
	transfer ownership to paperboatd and return after readiness

.PP
\fB--domain\fP=[]
	attach a verified custom domain (repeatable)

.PP
\fB--duration\fP=0s
	maximum preview lifetime (deprecated: use --ttl)

.PP
\fB--ephemeral\fP[=false]
	use the temporary preview lifecycle

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for tunnel

.PP
\fB--json\fP[=false]
	print the canonical preview resource as JSON

.PP
\fB--private\fP[=false]
	limit the preview to this account

.PP
\fB--team\fP[=false]
	require an explicit team grant for browser access

.PP
\fB--ttl\fP=0s
	bounded preview lifetime (maximum 24h)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to the CLI config file

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	paperboat-server base URL override


