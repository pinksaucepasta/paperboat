{
  "version": "1.0.0",
  "interfaces": {
    "fixture_manifest": {
      "supported": [
        "1"
      ],
      "owner": "platform"
    },
    "server_http": {
      "supported": [
        "1.0"
      ],
      "owner": "paperboat-server"
    },
    "runtime_application": {
      "supported": [
        "1.0"
      ],
      "owner": "paperboat"
    },
    "local_runtime_control": {
      "supported": [
        "1.0"
      ],
      "owner": "paperboat"
    },
    "edge_control": {
      "supported": [
        "1.0"
      ],
      "owner": "paperboat-server,paperboat-tunnel"
    }
  },
  "consumers": {
    "paperboat": {
      "server_http": [
        "1.0"
      ],
      "runtime_application": [
        "1.0"
      ],
      "local_runtime_control": [
        "1.0"
      ],
      "edge_control": [
        "1.0"
      ]
    },
    "paperboat-server": {
      "server_http": [
        "1.0"
      ],
      "edge_control": [
        "1.0"
      ]
    },
    "paperboat-tunnel": {
      "edge_control": [
        "1.0"
      ]
    }
  },
  "adjacent_pairs": [
    {
      "producer": "paperboat-server",
      "consumer": "paperboat",
      "interface": "server_http",
      "versions": [
        "1.0"
      ]
    },
    {
      "producer": "paperboat",
      "consumer": "paperboat",
      "interface": "runtime_application",
      "versions": [
        "1.0"
      ]
    },
    {
      "producer": "paperboat",
      "consumer": "paperboat",
      "interface": "local_runtime_control",
      "versions": [
        "1.0"
      ]
    },
    {
      "producer": "paperboat-server",
      "consumer": "paperboat",
      "interface": "edge_control",
      "versions": [
        "1.0"
      ]
    },
    {
      "producer": "paperboat-server",
      "consumer": "paperboat-tunnel",
      "interface": "edge_control",
      "versions": [
        "1.0"
      ]
    }
  ],
  "replacement": {
    "policy": "direct",
    "legacy_application_versions": "unsupported",
    "legacy_binary": "unsupported"
  },
  "unsupported": {
    "when": "the runtime application version is not exactly 1.0 or a required capability is unavailable",
    "error_code": "protocol_incompatible",
    "retryable": false,
    "mutation_allowed": false,
    "action": "install the matching pb release; mixed runtime application versions are unsupported"
  }
}
