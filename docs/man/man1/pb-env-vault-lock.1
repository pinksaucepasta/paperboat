.TH "PB-ENV-VAULT-LOCK" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-env-vault-lock - Clear unlocked vault keys while retaining encrypted custody


.SH SYNOPSIS
\fBpb env vault lock [flags]\fP


.SH DESCRIPTION
Clear unlocked vault keys while retaining encrypted custody

.PP
JSON output is supported with --json.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for lock

.PP
\fB--json\fP[=false]
	print canonical JSON


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to the CLI config file

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	paperboat-server base URL override


.SH SEE ALSO
\fBpb-env-vault(1)\fP
