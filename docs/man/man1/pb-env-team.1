.nh
.TH "PB-ENV-TEAM" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-env-team - Manage encrypted ENV team scopes


.SH SYNOPSIS
\fBpb env team [flags]\fP


.SH DESCRIPTION
Manage encrypted ENV team scopes

.PP
With --json, this command group lists its available commands.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for team


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to the CLI config file

.PP
\fB--json\fP[=false]
	print machine-readable JSON

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	paperboat-server base URL override


.SH SEE ALSO
\fBpb-env(1)\fP, \fBpb-env-team-create(1)\fP, \fBpb-env-team-grant(1)\fP, \fBpb-env-team-reset(1)\fP, \fBpb-env-team-revoke(1)\fP, \fBpb-env-team-rotate(1)\fP
