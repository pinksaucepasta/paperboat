.TH "PB-CONFIG-STATUS-BAR-SHOW" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-config-status-bar-show - Show the effective status-bar configuration


.SH SYNOPSIS
\fBpb config status-bar show [flags]\fP


.SH DESCRIPTION
Show the effective status-bar configuration

.PP
JSON output is supported with --json.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for show

.PP
\fB--json\fP[=false]
	print JSON


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to the CLI config file

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	paperboat-server base URL override


.SH SEE ALSO
\fBpb-config-status-bar(1)\fP
