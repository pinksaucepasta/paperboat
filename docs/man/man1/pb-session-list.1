.nh
.TH "PB-SESSION-LIST" "1" "Sep 2026" "Paperboat" "Paperboat CLI"

.SH NAME
pb-session-list - List durable terminal sessions


.SH SYNOPSIS
\fBpb session list [environment] [flags]\fP


.SH DESCRIPTION
List durable terminal sessions

.PP
JSON output is supported with --json.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--json\fP[=false]
	print JSON

.PP
\fB--wide\fP[=false]
	include immutable IDs


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to the CLI config file

.PP
\fB--no-customization\fP[=false]
	ignore local shortcuts, command defaults, and TUI preferences

.PP
\fB--server\fP=""
	paperboat-server base URL override


.SH SEE ALSO
\fBpb-session(1)\fP
