{$PAPERBOAT_API_HOST} {
	# Compress only read-only lists and the public trust set: no response here carries a credential, so compressing
	# it next to request-influenced fields cannot leak one (BREACH). Credential-minting responses, the peer-network
	# config (relay grants) and long polls stay uncompressed.
	@compressible expression `(method('GET') && path('/v1/machines', '/v1/machines/*/terminal-sessions', '/v1/terminal-sessions', '/v1/previews', '/v1/tunnels', '/v1/machine-services')) || (method('POST') && path('/v1/machine-peer-identity/status'))`
	encode @compressible zstd gzip
	# Edge control requests are logged at the proxy, so a refusal that never reached the server (no server log line,
	# e.g. the usage-report 400s of 2026-11-16) still shows who answered. Only /v1/edge/*; JSON; headers and TLS
	# fields dropped (credentials); bounded: 20 MiB per file, 5 files, 7 days.
	@not_edge not path /v1/edge/*
	log_skip @not_edge
	log edge_control {
		output file /data/access/edge-control.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format filter {
			request>headers delete
			request>tls delete
			resp_headers delete
			wrap json
		}
	}
	# Long-lived edge control and event streams outlive a rollout's Caddy reload; without this Caddy
	# closes them the moment the old config unloads (edges saw end_of_stream at every server rollout).
	reverse_proxy server:8080 {
		stream_close_delay 10m
	}
}
{$PAPERBOAT_DOWNLOAD_HOST} {
	@targets path /tuf/targets/*
	handle @targets {
		root * /srv/paperboat-releases/current
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		reverse_proxy server:8080 {
			stream_close_delay 10m
		}
	}
}
{$PAPERBOAT_DIAGNOSTICS_HOST} {
	reverse_proxy diagnostics:9000
}
# Production console (tools/console-prod.sh; systemd unit paperboat-console on the host).
{$PAPERBOAT_CONSOLE_HOST} {
	reverse_proxy 172.18.0.1:3100
}
