[Unit]
Description=Paperboat synthetic probe (exec, file send, public preview between two probe machines)

[Service]
Type=oneshot
# EnvironmentFile holds PB_BIN, PROBE_MACHINE_A, PROBE_MACHINE_B and the probe account's HOME; mode 0600.
EnvironmentFile=/etc/paperboat-probe.env
ExecStart=/usr/local/lib/paperboat-probe/probe.sh
# One JSON line per step lands in the journal; a failed unit is the alert signal (OnFailure= hook).
TimeoutStartSec=240
