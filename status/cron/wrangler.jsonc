// The cron Worker: decides every unit once a minute on the status D1 database (deploy.sh fills in the database id).
// Secrets: CHECKS. Vars: NET_CHECK_URL.
{
  "name": "paperboat-status-cron",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "paperboat-status", "database_id": "local" }]
}
