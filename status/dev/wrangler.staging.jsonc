// The drill's staging Worker (wrangler dev --local): the whole API and the cron in one process, with the staging catalog.
{
  "name": "paperboat-status-staging",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [{ "binding": "DB", "database_name": "paperboat-status-staging", "database_id": "local" }],
  "alias": { "../config/components.json": "../config/components.staging.json" }
}
