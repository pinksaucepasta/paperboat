---
import "../../../brand/styles/brand.css"
import "../styles/status.css"
import Footer from "../components/Footer.astro"
import Header from "../components/Header.astro"
import Subscribe from "../components/Subscribe.astro"
interface Props { title: string; description: string }
const { title, description } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf9" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="alternate" type="application/rss+xml" title="Paperboat status" href="/api/feed.xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to status</a>
    <Header />
    <main id="main" class="col"><slot /></main>
    <Footer />
    <Subscribe />
    <script>
      import "../scripts/subscribe.ts"
      // status.<domain> sits beside <domain>: point the logo and the footer's Paperboat link at the site.
      const h = location.hostname
      if (h.startsWith("status.")) {
        const site = `${location.protocol}//${h.slice("status.".length)}${location.port ? `:${location.port}` : ""}/`
        document.querySelectorAll<HTMLAnchorElement>(".top .lockup, [data-site-link]").forEach((a) => (a.href = site))
      }
    </script>
  </body>
</html>
