---
import Lockup from "../../../marketing/src/components/Lockup.astro"
// The logo links to the Paperboat site: status.<domain> is served beside <domain>, so the address is worked out in the browser (Base.astro).
---

<header class="top">
  <div class="col top-row">
    <div class="brand">
      <Lockup href="/" />
      <span class="brand-sep" aria-hidden="true">/</span>
      <span class="brand-page">Status</span>
    </div>
    <button type="button" class="btn btn-dark" data-subscribe-open>Subscribe to updates</button>
  </div>
</header>
