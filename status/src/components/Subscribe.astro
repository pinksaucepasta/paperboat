<dialog id="subscribe" class="dialog" aria-labelledby="subscribe-title">
  <form method="dialog" class="dialog-close-row"><button class="icon-btn" aria-label="Close">×</button></form>
  <h2 id="subscribe-title">Subscribe to updates</h2>
  <p class="muted">Get notified about incidents and maintenance.</p>
  <form id="subscribe-form" class="sub-form" novalidate>
    <label for="subscribe-email">Email</label>
    <div class="sub-row">
      <input id="subscribe-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@example.com" />
      <button type="submit" class="btn btn-primary">Subscribe</button>
    </div>
    <p id="subscribe-message" class="muted" role="status" aria-live="polite"></p>
  </form>
  <form id="webhook-form" class="sub-form" novalidate>
    <label for="webhook-url">Webhook</label>
    <div class="sub-row">
      <input id="webhook-url" name="url" type="url" required maxlength="500" placeholder="https://example.com/hooks/paperboat" />
      <button type="submit" class="btn btn-quiet">Add</button>
    </div>
    <p id="webhook-message" class="muted" role="status" aria-live="polite"></p>
    <div id="webhook-secret" class="webhook-secret" hidden>
      <p class="muted">Save these now; the secret is shown once. Deliveries are signed in <code>x-paperboat-signature</code> as <code>t=&lt;unix&gt;,v1=&lt;HMAC-SHA256 of "t.body"&gt;</code>. Answer the verification request with <code>&#123;"challenge": "…"&#125;</code>.</p>
      <label>Secret <input id="webhook-secret-value" readonly /></label>
      <label>Removal token <input id="webhook-token-value" readonly /></label>
    </div>
  </form>
  <div class="sub-feed">
    <span class="sub-feed-label">RSS</span>
    <input id="subscribe-feed" readonly aria-label="RSS feed address" value="" />
    <button type="button" class="btn btn-quiet" id="subscribe-copy">Copy</button>
  </div>
</dialog>
