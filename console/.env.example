# Names only. Values live in the deploy environment, never in git.
PAPERBOAT_SERVER_URL=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Error reporting (Sentry, errors only). Without the DSN the SDK is off.
# DSN of the `console` project; public, read at build time for the browser and at run time for the server.
NEXT_PUBLIC_SENTRY_DSN=
# Build time only: uploads source maps when set; the build passes without it.
SENTRY_AUTH_TOKEN=
# Build time: the region's Sentry host (EU). Organization (default pprbt) and project (default console) may be overridden.
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
# Build time: the release name; defaults to the build's git commit.
SENTRY_RELEASE=
