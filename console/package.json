{
  "name": "paperboat-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "terminal:wasm": "scripts/build-terminal-wasm.sh",
    "vault:wasm": "scripts/build-environment-vault-wasm.sh",
    "predev": "bun run terminal:wasm && bun run vault:wasm",
    "dev": "next dev",
    "prebuild": "bun run terminal:wasm && bun run vault:wasm",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:types": "openapi-typescript ../server/docs/openapi.json -o lib/api-schema.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.104.1",
    "@wterm/dom": "0.5.1",
    "@wterm/ghostty": "0.5.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "nuqs": "2.10.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.3",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "@wterm/dom@0.5.1": "patches/@wterm%2Fdom@0.5.1.patch"
  }
}
